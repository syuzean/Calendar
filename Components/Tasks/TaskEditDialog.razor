@using global::Calendar.Services
@using global::Calendar.Models
@inject TaskStore TaskStore

<div id="@BackdropId" class="dialog-backdrop task-modal-backdrop" role="presentation" @onclick="Cancel">
    <TaskModalInteraction BackdropId="@BackdropId" ModalId="@ModalId" ScrollRegionId="@ScrollRegionId" />
    <section id="@ModalId" class="event-dialog task-modal task-edit-dialog" role="dialog" aria-modal="true" tabindex="-1"
             aria-labelledby="task-edit-title" @onclick:stopPropagation="true" @onkeydown="HandleKeyDown">
        <header class="dialog-header">
            <div>
                <span class="eyebrow">EDIT TASK</span>
                <h2 id="task-edit-title">Update task details</h2>
                <p>Update the title, description, or priority.</p>
            </div>
            <button class="icon-button" aria-label="Close edit task dialog" type="button" @onclick="Cancel">×</button>
        </header>

        <form class="task-modal-form" @onsubmit="Submit" @onsubmit:preventDefault="true">
            <div id="@ScrollRegionId" class="task-modal-scroll">
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="auth-error" role="alert">@ErrorMessage</div>
            }
            <label class="field">
                <span>Title</span>
                <input autofocus maxlength="180" @bind="Title" @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(TitleError))
                {
                    <small class="field-error">@TitleError</small>
                }
            </label>
            <TaskProjectPicker @bind-Value="ProjectId" OpenUpward="true" />
            <TaskPriorityPicker @bind-Value="Priority" OpenUpward="true" />
            <div class="task-structured-fields">
                <TaskMentionEditor @ref="DescriptionEditor" Label="Description" Rows="7" Users="@MentionUsers" EnableImages="true"
                                   Placeholder="Describe the task, context, and expected outcome"
                                   @bind-Value="Description" @bind-MentionUserIds="DescriptionMentionUserIds" />
            </div>
            @if (Details.Attachments.Count > 0)
            {
                <div class="field task-existing-attachments">
                    <span>Current attachments</span>
                    <div>
                        @foreach (var attachment in Details.Attachments)
                        {
                            var removed = RemovedAttachmentIds.Contains(attachment.Id);
                            <article class="@(removed ? "removed" : null)">
                                <img src="@attachment.Url" alt="" />
                                <span><strong>@attachment.FileName</strong><small>@FormatSize(attachment.SizeBytes)</small></span>
                                <button type="button" @onclick="() => ToggleAttachmentRemoval(attachment.Id)">
                                    @(removed ? "Keep" : "Remove")
                                </button>
                            </article>
                        }
                    </div>
                </div>
            }
            <div class="field">
                <span>Add attachments <em>optional</em></span>
                <TaskAttachmentPicker @ref="AttachmentPicker" />
            </div>
            </div>
            <div class="dialog-actions">
                <span class="action-spacer"></span>
                <button class="secondary-button" type="button" disabled="@IsSubmitting" @onclick="Cancel">Cancel</button>
                <button class="primary-button" type="submit" disabled="@IsSubmitting">@(IsSubmitting ? "Saving…" : "Save changes")</button>
            </div>
        </form>
    </section>
</div>

@code {
    [Parameter, EditorRequired] public LumaTaskDetails Details { get; set; } = default!;
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public EventCallback CancelRequested { get; set; }
    [Parameter] public EventCallback<UpdateLumaTaskContentRequest> SubmitRequested { get; set; }

    private string Title = string.Empty;
    private readonly string ModalInstanceId = Guid.NewGuid().ToString("N");
    private string BackdropId => $"task-edit-backdrop-{ModalInstanceId}";
    private string ModalId => $"task-edit-modal-{ModalInstanceId}";
    private string ScrollRegionId => $"task-edit-scroll-{ModalInstanceId}";
    private string Description = string.Empty;
    private IReadOnlyCollection<Guid> DescriptionMentionUserIds = [];
    private string TitleError = string.Empty;
    private TaskPriority Priority;
    private Guid? ProjectId;
    private TaskAttachmentPicker? AttachmentPicker;
    private TaskMentionEditor? DescriptionEditor;
    private readonly HashSet<Guid> RemovedAttachmentIds = [];
    private IReadOnlyList<TaskMentionUserOption> MentionUsers = [];

    protected override async Task OnInitializedAsync()
    {
        Title = Details.Title;
        Description = Details.Description;
        Priority = Details.Priority;
        ProjectId = Details.ProjectId;
        MentionUsers = await TaskStore.LoadMentionUsersAsync();
        DescriptionMentionUserIds = Details.Mentions
            .Select(mention => mention.UserId)
            .ToArray();
    }

    private async Task Submit()
    {
        TitleError = string.IsNullOrWhiteSpace(Title) ? "Give your task a title." : string.Empty;
        if (TitleError.Length > 0) return;
        await SubmitRequested.InvokeAsync(new UpdateLumaTaskContentRequest(
            Title.Trim(), Description.Trim(), Details.Version, Priority, ProjectId,
            CombinedUploads(), RemovedAttachmentIds.ToArray(),
            DescriptionMentionUserIds));
    }

    private IReadOnlyList<TaskAttachmentUpload> CombinedUploads() =>
        (AttachmentPicker?.GetUploads() ?? [])
        .Concat(DescriptionEditor?.GetImageUploads() ?? [])
        .ToArray();

    private void ToggleAttachmentRemoval(Guid attachmentId)
    {
        if (!RemovedAttachmentIds.Add(attachmentId))
            RemovedAttachmentIds.Remove(attachmentId);
    }

    private static string FormatSize(long bytes) => bytes >= 1024 * 1024
        ? $"{bytes / 1024d / 1024d:0.#} MB"
        : $"{Math.Max(1, bytes / 1024d):0.#} KB";

    private Task Cancel() => CancelRequested.InvokeAsync();
    private Task HandleKeyDown(KeyboardEventArgs args) => args.Key == "Escape" ? Cancel() : Task.CompletedTask;
}
