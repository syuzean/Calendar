@using global::Calendar.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="field task-mention-editor @(Compact ? "task-mention-editor-compact" : null)" @onclick:stopPropagation="true">
    <div class="task-mention-editor-heading">
        <span>@Label @if (!string.IsNullOrWhiteSpace(HelpText)) { <em>@HelpText</em> }</span>
        @if (EnableImages)
        {
            <button type="button" class="task-markdown-image-action" title="Insert image at the cursor"
                    @onclick="ChooseImageAsync"><span aria-hidden="true">▧</span> Insert image</button>
        }
    </div>
    <div class="task-mention-input-wrap">
        <textarea id="@EditorId" @ref="TextArea" rows="@Rows" maxlength="@MaxLength" value="@Value"
                  placeholder="@Placeholder" aria-label="@Label"
                  aria-autocomplete="list" aria-expanded="@ShowSuggestions"
                  @oninput="HandleInputAsync" @onkeydown="HandleKeyDown" @onblur="HideSuggestions"
                  @onkeydown:stopPropagation="ShowSuggestions"></textarea>
        @if (EnableImages)
        {
            <InputFile id="@ImageInputId" class="task-markdown-image-input" OnChange="ImagesSelectedAsync" multiple
                       accept="image/png,image/jpeg,image/gif,image/webp" />
        }
        @if (ShowSuggestions)
        {
            <div class="task-mention-menu @(Context?.PlaceAbove == true ? "task-mention-menu-above" : null) @(FilteredUsers.Count == 0 ? "task-mention-menu-empty-state" : null)"
                 style="@PopoverStyle" role="listbox" aria-label="Mention a LUMA user">
                @if (FilteredUsers.Count == 0)
                {
                    <span class="task-mention-empty"><i aria-hidden="true">⚠</i> No matching LUMA users</span>
                }
                else
                {
                    @foreach (var user in FilteredUsers)
                    {
                        <button type="button" role="option"
                                @onpointerdown="() => SelectUserAsync(user)"
                                @onpointerdown:preventDefault="true"
                                @onpointerdown:stopPropagation="true">
                            <span class="task-mention-avatar" aria-hidden="true">@InitialFor(user.Name)</span>
                            <span><strong>@user.Name</strong><small>@user.Email</small></span>
                            <i aria-hidden="true">@@</i>
                        </button>
                    }
                }
            </div>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(ImageError))
    {
        <small class="task-markdown-image-error" role="alert">@ImageError</small>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public int Rows { get; set; } = 4;
    [Parameter] public int MaxLength { get; set; } = 10000;
    [Parameter] public string HelpText { get; set; } = "optional · Markdown · @mentions";
    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool EnableImages { get; set; }
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public IReadOnlyCollection<Guid> MentionUserIds { get; set; } = [];
    [Parameter] public EventCallback<IReadOnlyCollection<Guid>> MentionUserIdsChanged { get; set; }
    [Parameter] public IReadOnlyList<TaskMentionUserOption> Users { get; set; } = [];

    private ElementReference TextArea;
    private readonly string componentId = Guid.NewGuid().ToString("N");
    private readonly List<InlineImageFile> InlineImages = [];
    private MentionContext? Context;
    private bool ShowSuggestions;
    private bool imageInteropInitialized;
    private string ImageError = string.Empty;
    private string EditorId => $"task-markdown-editor-{componentId}";
    private string ImageInputId => $"task-markdown-image-input-{componentId}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !EnableImages) return;
        await JS.InvokeVoidAsync("lumaTaskAttachments.initializeMarkdownEditor", EditorId, ImageInputId);
        imageInteropInitialized = true;
    }

    public IReadOnlyList<TaskAttachmentUpload> GetImageUploads() => InlineImages
        .Select(image => new TaskAttachmentUpload(
            image.File.Name,
            image.File.ContentType,
            image.File.Size,
            () => image.File.OpenReadStream(TaskAttachmentRules.MaximumFileSizeBytes),
            image.Token))
        .ToArray();

    private string PopoverStyle => Context is null
        ? string.Empty
        : FormattableString.Invariant(
            $"left:{Context.Left}px;top:{Context.Top}px;width:{Math.Min(Context.Width, FilteredUsers.Count == 0 ? 176 : Context.Width)}px;max-height:{Context.MaxHeight}px;");

    private IReadOnlyList<TaskMentionUserOption> FilteredUsers
    {
        get
        {
            var query = Context?.Query?.Trim() ?? string.Empty;
            return Users
                .Where(user => user.Name.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    user.Email.Contains(query, StringComparison.OrdinalIgnoreCase))
                .Take(20)
                .ToArray();
        }
    }

    private async Task HandleInputAsync(ChangeEventArgs args)
    {
        Value = args.Value?.ToString() ?? string.Empty;
        await ValueChanged.InvokeAsync(Value);
        var retainedMentionIds = MentionUserIds
            .Where(userId => Users.FirstOrDefault(user => user.Id == userId) is { } user &&
                             TaskMentionSyntax.ContainsVisibleMention(Value, user.Name))
            .Concat(TaskMentionSyntax.FindUniqueVisibleMentionUserIds(
                Value,
                Users.Select(user => new KeyValuePair<Guid, string>(user.Id, user.Name))))
            .Distinct()
            .ToArray();
        if (!MentionUserIds.Order().SequenceEqual(retainedMentionIds.Order()))
            await MentionUserIdsChanged.InvokeAsync(retainedMentionIds);
        Context = await JS.InvokeAsync<MentionContext?>("lumaTaskMentions.getContext", TextArea);
        ShowSuggestions = Context is not null;
    }

    private async Task SelectUserAsync(TaskMentionUserOption user)
    {
        if (Context is null) return;
        Value = await JS.InvokeAsync<string>(
            "lumaTaskMentions.insert",
            TextArea,
            Context.Start,
            Context.End,
            TaskMentionSyntax.CreateVisibleMention(user.Name));
        var updatedMentionIds = MentionUserIds.Append(user.Id).Distinct().ToArray();
        Context = null;
        ShowSuggestions = false;
        await ValueChanged.InvokeAsync(Value);
        await MentionUserIdsChanged.InvokeAsync(updatedMentionIds);
    }

    private Task ChooseImageAsync() => EnableImages
        ? JS.InvokeVoidAsync("lumaTaskAttachments.chooseMarkdownImage", EditorId, ImageInputId).AsTask()
        : Task.CompletedTask;

    private async Task ImagesSelectedAsync(InputFileChangeEventArgs args)
    {
        ImageError = string.Empty;
        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = args.GetMultipleFiles(TaskAttachmentRules.MaximumAttachmentCount);
        }
        catch (InvalidOperationException)
        {
            ImageError = $"Choose no more than {TaskAttachmentRules.MaximumAttachmentCount} images.";
            return;
        }

        var markdown = new List<string>();
        foreach (var file in files)
        {
            if (InlineImages.Count >= TaskAttachmentRules.MaximumAttachmentCount)
            {
                ImageError = $"Choose no more than {TaskAttachmentRules.MaximumAttachmentCount} inline images.";
                break;
            }
            if (file.Size > TaskAttachmentRules.MaximumFileSizeBytes)
            {
                ImageError = $"{file.Name} is larger than 5 MB.";
                continue;
            }
            if (!IsSupportedImage(file.ContentType))
            {
                ImageError = $"{file.Name} is not a supported image.";
                continue;
            }

            var token = Guid.NewGuid().ToString("N");
            InlineImages.Add(new InlineImageFile(file, token));
            markdown.Add(TaskMarkdownImageSyntax.CreateMarkdown(file.Name, token));
        }

        if (markdown.Count > 0)
            await JS.InvokeVoidAsync("lumaTaskAttachments.insertMarkdownImages", EditorId, string.Join("\n", markdown));
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            HideSuggestions();
    }

    private void HideSuggestions()
    {
        Context = null;
        ShowSuggestions = false;
    }

    private static string InitialFor(string name) => string.IsNullOrWhiteSpace(name)
        ? "?"
        : char.ToUpperInvariant(name.Trim()[0]).ToString();

    private static bool IsSupportedImage(string contentType) => contentType is
        "image/png" or "image/jpeg" or "image/gif" or "image/webp";

    public async ValueTask DisposeAsync()
    {
        if (!imageInteropInitialized) return;
        try { await JS.InvokeVoidAsync("lumaTaskAttachments.disposeMarkdownEditor", EditorId); }
        catch (JSDisconnectedException) { }
    }

    private sealed record InlineImageFile(IBrowserFile File, string Token);

    private sealed class MentionContext
    {
        public int Start { get; set; }
        public int End { get; set; }
        public string Query { get; set; } = string.Empty;
        public double Left { get; set; }
        public double Top { get; set; }
        public double Width { get; set; }
        public double MaxHeight { get; set; }
        public bool PlaceAbove { get; set; }
    }
}
