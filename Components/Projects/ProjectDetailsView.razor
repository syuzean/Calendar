@using global::Calendar.Models
@using global::Calendar.Services
@using global::Calendar.Components.Tasks
@inject TaskStore TaskStore
@inject ProjectStore ProjectStore

<section class="project-details-view" aria-label="Project details">
    <button class="project-back-button" type="button" @onclick="BackRequested"><span aria-hidden="true">‹</span> Back to projects</button>

    @if (IsLoading)
    {
        <div class="project-details-state" role="status">Loading project…</div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="project-details-state error" role="alert">@ErrorMessage</div>
    }
    else if (Details is not null)
    {
        <header class="project-details-header">
            <span class="project-details-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7.5h6l2 2h8v9.5H4z"></path><path d="M4 7.5V5h6l2 2h8v2.5"></path></svg></span>
            <div class="project-details-heading-copy">
                <span class="eyebrow">PROJECT</span><h2>@Details.Name</h2>
                <p>Created by <strong>@Details.CreatedByName</strong> · @Details.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</p>
            </div>
            <div class="project-progress" aria-label="@ProgressLabel">
                <strong>@TaskCountLabel(Details.TaskCount)</strong>
                @if (Details.TaskCount > 0) { <small>@Details.DoneTaskCount done</small><span><i style="width:@($"{ProgressPercent}%")"></i></span> }
            </div>
        </header>

        <div class="project-description-card"><span>DESCRIPTION</span><p>@(string.IsNullOrWhiteSpace(Details.Description) ? "No description provided." : Details.Description)</p></div>

        <section class="project-features" aria-labelledby="project-features-heading">
            <header>
                <div><span>ORGANIZATION</span><h3 id="project-features-heading">Features</h3></div>
                @if (Details.CanManageFeatures)
                {
                    <button type="button" @onclick="OpenNewFeature">+ Add feature</button>
                }
            </header>
            @if (!string.IsNullOrWhiteSpace(FeatureError))
            {
                <div class="project-feature-error" role="alert">@FeatureError</div>
            }
            @if (ShowFeatureEditor)
            {
                <form class="project-feature-editor" @onsubmit="SaveFeatureAsync" @onsubmit:preventDefault="true">
                    <label><span>Name</span><input maxlength="120" autofocus @bind="FeatureName" @bind:event="oninput" /></label>
                    <label><span>Description <em>optional</em></span><input maxlength="2000" @bind="FeatureDescription" @bind:event="oninput" /></label>
                    <div><button type="button" @onclick="CloseFeatureEditor">Cancel</button><button class="primary" type="submit">@(EditingFeatureId is null ? "Create" : "Save")</button></div>
                </form>
            }
            @if (FeaturesLoading)
            {
                <div class="project-feature-state">Loading features…</div>
            }
            else if (Features.Count == 0)
            {
                <div class="project-feature-state">No features yet. Features can group related Tasks and Bugs.</div>
            }
            else
            {
                <div class="project-feature-list">
                    @foreach (var feature in Features)
                    {
                        <article>
                            <button class="project-feature-main" type="button" title="Filter project tasks by this feature" @onclick="() => FilterByFeatureAsync(feature.Id)">
                                <i aria-hidden="true">#</i><span><strong>@feature.Name</strong><small>@(string.IsNullOrWhiteSpace(feature.Description) ? "No description" : feature.Description)</small></span><b>@WorkItemCount(feature.WorkItemCount)</b>
                            </button>
                            @if (Details.CanManageFeatures)
                            {
                                <div class="project-feature-actions">
                                    <button type="button" aria-label="Edit @feature.Name" @onclick="() => OpenEditFeature(feature)">Edit</button>
                                    @if (PendingDeleteFeatureId == feature.Id)
                                    {
                                        <button class="danger" type="button" @onclick="() => DeleteFeatureAsync(feature.Id)">Confirm remove</button>
                                        <button type="button" @onclick="CancelFeatureDelete">Cancel</button>
                                    }
                                    else
                                    {
                                        <button type="button" aria-label="Remove @feature.Name" @onclick="() => ConfirmFeatureDelete(feature.Id)">Remove</button>
                                    }
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        </section>

        <div class="project-task-view-row">
            <div class="project-task-view-switch" role="group" aria-label="Project task view">
                <button type="button" class="@(Presentation == ProjectTaskPresentation.List ? "active" : null)"
                        aria-pressed="@(Presentation == ProjectTaskPresentation.List)" @onclick="ShowList">List</button>
                <button type="button" class="@(Presentation == ProjectTaskPresentation.Board ? "active" : null)"
                        aria-pressed="@(Presentation == ProjectTaskPresentation.Board)" @onclick="ShowBoard">Board</button>
            </div>
        </div>

        <div class="project-task-tools" aria-label="Filter project tasks">
            <label class="project-task-search"><span aria-hidden="true">⌕</span><input type="search" placeholder="Search tasks…" aria-label="Search project tasks by title" @bind="Search" @bind:event="oninput" @bind:after="ApplyFiltersAsync" /></label>
            <label><span>Assignee</span><select @bind="Assignee" @bind:after="ApplyFiltersAsync"><option value="">All</option><option value="Unassigned">Unassigned</option>@foreach (var option in Assignees) { <option value="@option.Id">@option.Name</option> }</select></label>
            <label><span>Work</span><select @bind="Work" @bind:after="ApplyFiltersAsync"><option value="">All</option><option value="ToDo">To Do</option><option value="InProgress">In Progress</option><option value="Done">Done</option></select></label>
            <label><span>Assignment</span><select @bind="Assignment" @bind:after="ApplyFiltersAsync"><option value="">All</option><option value="Pending">Pending</option><option value="Accepted">Accepted</option><option value="DeadlineChangeRequested">Deadline requested</option></select></label>
            <label><span>Priority</span><select @bind="Priority" @bind:after="ApplyFiltersAsync"><option value="">All</option><option value="None">No priority</option><option value="Low">Low</option><option value="Medium">Medium</option><option value="High">High</option><option value="Urgent">Urgent</option></select></label>
            <TaskFeatureFilter Options="@Features" Value="@FeatureIds" ValueChanged="ApplyFeatureFilterAsync" />
            <label><span>Deadline</span><select @bind="Deadline" @bind:after="ApplyFiltersAsync"><option value="All">All</option><option value="NoDeadline">No deadline</option><option value="Overdue">Overdue</option><option value="Today">Today</option><option value="ThisWeek">This week</option></select></label>
            <label><span>Sort</span><select @bind="Sort" @bind:after="ApplyFiltersAsync"><option value="DeadlineNearest">Deadline: nearest</option><option value="PriorityHighest">Priority: highest</option><option value="Newest">Newest</option></select></label>
            @if (HasFilters) { <button type="button" @onclick="ClearFiltersAsync">Clear</button> }
        </div>

        @if (TasksLoading)
        {
            <div class="project-task-state" role="status">Loading project tasks…</div>
        }
        else if (!string.IsNullOrWhiteSpace(TasksError))
        {
            <div class="project-task-state error" role="alert">@TasksError</div>
        }
        else if (Presentation == ProjectTaskPresentation.Board)
        {
            <div class="project-task-board" aria-label="Project task Board">
                @foreach (var status in BoardStatuses)
                {
                    var columnItems = Tasks.Where(task => task.WorkStatus == status).ToArray();
                    <section class="project-board-column" data-task-drop="@status" aria-label="@WorkLabel(status) tasks">
                        <header><h3>@WorkLabel(status)</h3><span>@columnItems.Length</span></header>
                        <div class="project-board-column-body">
                            @if (columnItems.Length == 0)
                            {
                                <div class="project-board-empty">No tasks here</div>
                            }
                            else
                            {
                                @foreach (var task in columnItems)
                                {
                                    var deadlineClass = DeadlineClass(task.Deadline);
                                    var canDrag = CanDrag(task);
                                    <button type="button" class="project-board-card @deadlineClass"
                                            draggable="@(canDrag ? "true" : "false")"
                                            data-task-board-card="true"
                                            data-task-drag="@(canDrag ? task.Id.ToString("D") : null)"
                                            data-task-version="@(canDrag ? task.Version.ToString("D") : null)"
                                            data-work-status="@(canDrag ? task.WorkStatus.ToString() : null)"
                                            title="@(canDrag ? "Drag to the next work stage" : "Open task details")"
                                            @onclick="() => OpenTaskRequested.InvokeAsync(task.Id)">
                                        <span class="task-title-priority-row">
                                            <strong>@task.Title</strong>
                                            <span class="task-priority-inline @PriorityClass(task.Priority)"><i aria-hidden="true"></i>@PriorityLabel(task.Priority)</span>
                                        </span>
                                        <span class="project-board-person">@(IsUnassigned(task) ? "Unassigned" : $"Assigned to {task.AssigneeName}")</span>
                                        <span class="project-task-badges">
                                            <i class="assignment @AssignmentClass(task.AssignmentStatus, task.IsInvited, IsUnassigned(task))">@AssignmentLabel(task.AssignmentStatus, task.IsInvited, IsUnassigned(task))</i>
                                        </span>
                                        <span class="project-board-deadline @deadlineClass">
                                            @if (task.Deadline is { } boardDeadline)
                                            {
                                                <time datetime="@boardDeadline.ToString("yyyy-MM-dd")">@FormatDeadline(boardDeadline)</time>
                                            }
                                            else
                                            {
                                                <span>No deadline</span>
                                            }
                                        </span>
                                    </button>
                                }
                            }
                        </div>
                    </section>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(BoardError))
            {
                <div class="project-board-message error" role="alert">@BoardError</div>
            }
            else if (!string.IsNullOrWhiteSpace(BoardNotice))
            {
                <div class="project-board-message" role="status">@BoardNotice</div>
            }
        }
        else if (Tasks.Count == 0)
        {
            <div class="project-empty-tasks">
                <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 4h10M8 2.8h8v3.4H8zM6 5h12a2 2 0 0 1 2 2v13H4V7a2 2 0 0 1 2-2z"></path><path d="m8 13 2.2 2.2L16 9.5"></path></svg></span>
                <strong>@(HasFilters ? "No project tasks match these filters." : "No tasks in this project yet.")</strong>
                <small>@(HasFilters ? "Try clearing one or more filters." : "Choose this project when creating or editing a task.")</small>
            </div>
        }
        else
        {
            <div class="project-task-list">
                @foreach (var task in Tasks)
                {
                    <button type="button" class="project-task-card" @onclick="() => OpenTaskRequested.InvokeAsync(task.Id)">
                        <span class="project-task-main">
                            <span class="task-title-priority-row">
                                <strong>@task.Title</strong>
                                <span class="task-priority-inline @PriorityClass(task.Priority)"><i aria-hidden="true"></i>@PriorityLabel(task.Priority)</span>
                            </span>
                            <small>@(IsUnassigned(task) ? "Unassigned" : $"Assigned to {task.AssigneeName}")</small>
                        </span>
                        <span class="project-task-badges"><i class="work @WorkClass(task.WorkStatus)">@WorkLabel(task.WorkStatus)</i><i class="assignment @AssignmentClass(task.AssignmentStatus, task.IsInvited, IsUnassigned(task))">@AssignmentLabel(task.AssignmentStatus, task.IsInvited, IsUnassigned(task))</i></span>
                        @if (task.Deadline is { } deadline)
                        {
                            <time datetime="@deadline.ToString("yyyy-MM-dd")">@deadline.ToString("MMM d, yyyy")</time>
                        }
                        else
                        {
                            <span class="project-task-no-deadline">No deadline</span>
                        }
                        <span class="project-task-arrow" aria-hidden="true">›</span>
                    </button>
                }
            </div>
        }
    }
</section>

@code {
    [Parameter] public ProjectDetails? Details { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public long RefreshKey { get; set; }
    [Parameter] public EventCallback BackRequested { get; set; }
    [Parameter] public EventCallback<Guid> OpenTaskRequested { get; set; }
    [Parameter] public EventCallback TaskChanged { get; set; }
    [Parameter] public EventCallback FeatureChanged { get; set; }

    private IReadOnlyList<RelatedLumaTask> Tasks = [];
    private IReadOnlyList<AssigneeFilterOption> Assignees = [];
    private IReadOnlyList<FeatureSummary> Features = [];
    private IReadOnlyCollection<Guid> FeatureIds = [];
    private Guid? LoadedProjectId;
    private long LoadedRefreshKey = -1;
    private bool TasksLoading;
    private string TasksError = string.Empty;
    private string Search = string.Empty;
    private string Assignee = string.Empty;
    private string Work = string.Empty;
    private string Assignment = string.Empty;
    private string Priority = string.Empty;
    private string Deadline = nameof(TaskDeadlineFilter.All);
    private string Sort = nameof(TaskSortOrder.DeadlineNearest);
    private string BoardError = string.Empty;
    private string BoardNotice = string.Empty;
    private ProjectTaskPresentation Presentation = ProjectTaskPresentation.List;
    private bool FeaturesLoading;
    private bool ShowFeatureEditor;
    private Guid? EditingFeatureId;
    private Guid? PendingDeleteFeatureId;
    private string FeatureName = string.Empty;
    private string FeatureDescription = string.Empty;
    private string FeatureError = string.Empty;
    private static readonly TaskWorkStatus[] BoardStatuses =
        [TaskWorkStatus.ToDo, TaskWorkStatus.InProgress, TaskWorkStatus.Done];

    private bool HasFilters => !string.IsNullOrWhiteSpace(Search) || Assignee.Length > 0 || Work.Length > 0 || Assignment.Length > 0 || Priority.Length > 0 || FeatureIds.Count > 0 || Deadline != nameof(TaskDeadlineFilter.All) || Sort != nameof(TaskSortOrder.DeadlineNearest);
    private int ProgressPercent => Details is { TaskCount: > 0 } ? (int)Math.Round(Details.DoneTaskCount * 100d / Details.TaskCount) : 0;
    private string ProgressLabel => Details is null ? string.Empty : $"{Details.DoneTaskCount} of {Details.TaskCount} tasks completed";

    protected override async Task OnParametersSetAsync()
    {
        if (Details is null || (LoadedProjectId == Details.Id && LoadedRefreshKey == RefreshKey)) return;
        LoadedProjectId = Details.Id;
        LoadedRefreshKey = RefreshKey;
        await Task.WhenAll(LoadTasksAsync(refreshAssignees: true), LoadFeaturesAsync());
    }

    private Task ApplyFiltersAsync() => LoadTasksAsync(refreshAssignees: false);

    private async Task ApplyFeatureFilterAsync(IReadOnlyCollection<Guid> featureIds)
    {
        FeatureIds = featureIds;
        await LoadTasksAsync(refreshAssignees: false);
    }

    private void ShowList()
    {
        Presentation = ProjectTaskPresentation.List;
        ClearBoardMessages();
    }

    private void ShowBoard()
    {
        Presentation = ProjectTaskPresentation.Board;
        ClearBoardMessages();
    }

    public async Task HandleBoardDropAsync(string taskIdValue, string targetStatusValue, string versionValue)
    {
        ClearBoardMessages();
        if (!Guid.TryParse(taskIdValue, out var taskId) ||
            !Guid.TryParse(versionValue, out var version) ||
            !Enum.TryParse<TaskWorkStatus>(targetStatusValue, out var targetStatus))
        {
            BoardError = "The task drop could not be understood. Reload the page and try again.";
            return;
        }

        var task = Tasks.SingleOrDefault(item => item.Id == taskId);
        if (task is null || !CanDrag(task) || !IsForwardTransition(task.WorkStatus, targetStatus))
        {
            BoardError = "Tasks can move only forward after the Task Doer accepts them.";
            return;
        }

        try
        {
            await TaskStore.ChangeWorkStatusAsync(taskId, new ChangeTaskWorkStatusRequest(targetStatus, version));
            BoardNotice = TaskStore.LastNotice ?? $"Task moved to {WorkLabel(targetStatus)}.";
            await LoadTasksAsync(refreshAssignees: false);
            await TaskChanged.InvokeAsync();
        }
        catch (Exception exception) when (exception is LumaTaskNotFoundException or UnauthorizedAccessException or System.ComponentModel.DataAnnotations.ValidationException)
        {
            BoardError = exception.Message;
            await LoadTasksAsync(refreshAssignees: false);
        }
    }

    public void ShowInvalidBoardDrop()
    {
        BoardNotice = string.Empty;
        BoardError = "Tasks can move only forward: To Do → In Progress → Done.";
    }

    private void ClearBoardMessages()
    {
        BoardError = string.Empty;
        BoardNotice = string.Empty;
    }

    private async Task LoadFeaturesAsync()
    {
        if (Details is null) return;
        FeaturesLoading = true;
        FeatureError = string.Empty;
        try
        {
            Features = await ProjectStore.LoadFeaturesAsync(Details.Id);
            var available = Features.Select(feature => feature.Id).ToHashSet();
            if (FeatureIds.Any(id => !available.Contains(id)))
                FeatureIds = FeatureIds.Where(available.Contains).ToArray();
        }
        catch (Exception exception) when (exception is UnauthorizedAccessException or ProjectNotFoundException)
        {
            FeatureError = exception.Message;
        }
        finally { FeaturesLoading = false; }
    }

    private void OpenNewFeature()
    {
        EditingFeatureId = null;
        FeatureName = FeatureDescription = FeatureError = string.Empty;
        ShowFeatureEditor = true;
    }

    private void OpenEditFeature(FeatureSummary feature)
    {
        EditingFeatureId = feature.Id;
        FeatureName = feature.Name;
        FeatureDescription = feature.Description;
        FeatureError = string.Empty;
        ShowFeatureEditor = true;
    }

    private void CloseFeatureEditor()
    {
        ShowFeatureEditor = false;
        EditingFeatureId = null;
        FeatureName = FeatureDescription = string.Empty;
    }

    private async Task SaveFeatureAsync()
    {
        if (Details is null) return;
        FeatureError = string.Empty;
        try
        {
            var request = new SaveFeatureRequest(FeatureName, FeatureDescription);
            if (EditingFeatureId is { } featureId)
                await ProjectStore.UpdateFeatureAsync(featureId, request);
            else
                await ProjectStore.CreateFeatureAsync(Details.Id, request);
            CloseFeatureEditor();
            await LoadFeaturesAsync();
            await FeatureChanged.InvokeAsync();
        }
        catch (Exception exception) when (exception is System.ComponentModel.DataAnnotations.ValidationException or UnauthorizedAccessException)
        {
            FeatureError = exception.Message;
        }
    }

    private void ConfirmFeatureDelete(Guid featureId) => PendingDeleteFeatureId = featureId;
    private void CancelFeatureDelete() => PendingDeleteFeatureId = null;

    private async Task DeleteFeatureAsync(Guid featureId)
    {
        FeatureError = string.Empty;
        try
        {
            await ProjectStore.DeleteFeatureAsync(featureId);
            PendingDeleteFeatureId = null;
            FeatureIds = FeatureIds.Where(id => id != featureId).ToArray();
            await Task.WhenAll(LoadFeaturesAsync(), LoadTasksAsync(refreshAssignees: false));
            await FeatureChanged.InvokeAsync();
        }
        catch (Exception exception) when (exception is System.ComponentModel.DataAnnotations.ValidationException or UnauthorizedAccessException)
        {
            FeatureError = exception.Message;
        }
    }

    private async Task FilterByFeatureAsync(Guid featureId)
    {
        FeatureIds = [featureId];
        await LoadTasksAsync(refreshAssignees: false);
    }

    private async Task ClearFiltersAsync()
    {
        Search = Work = Assignment = Priority = Assignee = string.Empty;
        FeatureIds = [];
        Deadline = nameof(TaskDeadlineFilter.All); Sort = nameof(TaskSortOrder.DeadlineNearest);
        await LoadTasksAsync(refreshAssignees: false);
    }

    private async Task LoadTasksAsync(bool refreshAssignees)
    {
        if (Details is null) return;
        TasksLoading = true; TasksError = string.Empty;
        try
        {
            if (refreshAssignees)
            {
                var all = await TaskStore.LoadProjectTasksAsync(Details.Id);
                Assignees = all.Where(task => task.AssigneeId is not null)
                    .GroupBy(task => new { Id = task.AssigneeId!.Value, task.AssigneeName })
                    .Select(group => new AssigneeFilterOption(group.Key.Id, group.Key.AssigneeName))
                    .OrderBy(option => option.Name).ToArray();
            }
            var assigneeId = Guid.TryParse(Assignee, out var parsedAssignee) ? parsedAssignee : (Guid?)null;
            Tasks = await TaskStore.LoadProjectTasksAsync(Details.Id, new TaskListQuery(
                Search: Search,
                WorkStatus: Parse<TaskWorkStatus>(Work),
                AssignmentStatus: Parse<TaskAssignmentStatus>(Assignment),
                Priority: Parse<TaskPriority>(Priority),
                Deadline: Enum.TryParse<TaskDeadlineFilter>(Deadline, out var deadline) ? deadline : TaskDeadlineFilter.All,
                Sort: Enum.TryParse<TaskSortOrder>(Sort, out var sort) ? sort : TaskSortOrder.DeadlineNearest,
                ProjectId: Details.Id,
                AssigneeIds: assigneeId is null ? [] : [assigneeId.Value],
                IncludeUnassigned: Assignee == "Unassigned",
                FeatureIds: FeatureIds));
        }
        catch (Exception exception) when (exception is UnauthorizedAccessException or ProjectNotFoundException) { TasksError = exception.Message; }
        finally { TasksLoading = false; }
    }

    private static TEnum? Parse<TEnum>(string value) where TEnum : struct, Enum => Enum.TryParse<TEnum>(value, out var parsed) ? parsed : null;
    private static string TaskCountLabel(int count) => count == 1 ? "1 task" : $"{count} tasks";
    private static string WorkItemCount(int count) => count == 1 ? "1 work item" : $"{count} work items";
    private static string PriorityClass(TaskPriority value) => value.ToString().ToLowerInvariant();
    private static string PriorityLabel(TaskPriority value) => value == TaskPriority.None ? "No priority" : value.ToString();
    private static string WorkClass(TaskWorkStatus value) => value == TaskWorkStatus.InProgress ? "in-progress" : value.ToString().ToLowerInvariant();
    private static string WorkLabel(TaskWorkStatus value) => value == TaskWorkStatus.InProgress ? "In Progress" : value == TaskWorkStatus.ToDo ? "To Do" : "Done";
    private static string AssignmentClass(TaskAssignmentStatus value, bool invited, bool unassigned) => unassigned ? "unassigned" : invited ? "invited" : value == TaskAssignmentStatus.DeadlineChangeRequested ? "requested" : value.ToString().ToLowerInvariant();
    private static string AssignmentLabel(TaskAssignmentStatus value, bool invited, bool unassigned) => unassigned ? "Unassigned" : invited ? "Invited" : value == TaskAssignmentStatus.DeadlineChangeRequested ? "Deadline requested" : value.ToString();
    private static bool IsUnassigned(RelatedLumaTask task) => task.AssigneeId is null && !task.IsInvited;
    private static bool CanDrag(RelatedLumaTask task) =>
        task.CanManageWorkStatus && task.AssignmentStatus == TaskAssignmentStatus.Accepted && task.WorkStatus != TaskWorkStatus.Done;
    private static bool IsForwardTransition(TaskWorkStatus current, TaskWorkStatus target) =>
        (current, target) is (TaskWorkStatus.ToDo, TaskWorkStatus.InProgress) or (TaskWorkStatus.InProgress, TaskWorkStatus.Done);
    private static string FormatDeadline(DateOnly? deadline)
    {
        if (deadline is null) return "No deadline";
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (deadline.Value == today) return "Today";
        if (deadline.Value < today) return $"Overdue · {deadline.Value:MMM d, yyyy}";
        return deadline.Value.ToString("MMM d, yyyy");
    }
    private static string DeadlineClass(DateOnly? deadline)
    {
        if (deadline is null) return "no-deadline";
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (deadline.Value < today) return "overdue";
        return deadline.Value == today ? "due-today" : string.Empty;
    }
    private sealed record AssigneeFilterOption(Guid Id, string Name);
    private enum ProjectTaskPresentation { List, Board }
}
