@page "/tasks"
@rendermode InteractiveServer
@attribute [Authorize]
@inject TaskStore TaskStore
@inject ProjectStore ProjectStore
@inject IJSRuntime JS
@using global::Calendar.Components.Projects
@using global::Calendar.Components.Tasks
@using global::Calendar.Models
@using global::Calendar.Services
@using Microsoft.JSInterop
@implements IAsyncDisposable

<PageTitle>Tasks · Luma</PageTitle>

<div class="calendar-app tasks-app">
    <main class="tasks-main">
        <header class="tasks-header">
            <div class="tasks-heading-row">
                <div>
                    <span class="eyebrow">WORKSPACE</span>
                    <h1>Tasks</h1>
                </div>
                <div class="tasks-header-actions">
                    <button class="primary-button tasks-create-button" type="button" @onclick="OpenPrimaryCreate">
                        <span aria-hidden="true">+</span>
                        @(ActiveTab == TaskListTab.Projects ? "Create project" : "Create task")
                    </button>
                </div>
            </div>
        </header>

        @if (!string.IsNullOrEmpty(FeedbackMessage))
        {
            <div class="tasks-feedback" role="status">
                <span aria-hidden="true">✓</span>
                <div>
                    <strong>@FeedbackTitle</strong>
                    <small>@FeedbackMessage</small>
                </div>
                <button type="button" aria-label="Dismiss message" @onclick="DismissFeedback">×</button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(TaskInvitationError))
        {
            <div class="tasks-invitation-error" role="alert">@TaskInvitationError</div>
        }

        <section class="tasks-surface" aria-label="Tasks and projects workspace">
            <div class="tasks-workspace">
                <div class="task-view-bar">
                    <div class="task-tabs" role="tablist" aria-label="Tasks workspace view">
                        <button type="button" role="tab" aria-selected="@(ActiveTab == TaskListTab.Tasks)"
                                class="@(ActiveTab == TaskListTab.Tasks ? "active" : null)" @onclick="ShowTasks">
                            Tasks <span>@RelatedTasks.Count</span>
                        </button>
                        <button type="button" role="tab" aria-selected="@(ActiveTab == TaskListTab.Projects)"
                                class="@(ActiveTab == TaskListTab.Projects ? "active" : null)" @onclick="ShowProjects">
                            Projects <span>@Projects.Count</span>
                        </button>
                    </div>
                    @if (ActiveTab != TaskListTab.Projects)
                    {
                        <div class="task-presentation-switch" role="group" aria-label="Task presentation">
                            <button type="button" class="@(Presentation == TaskPresentation.List ? "active" : null)"
                                    aria-pressed="@(Presentation == TaskPresentation.List)" @onclick="ShowList">List</button>
                            <button type="button" class="@(Presentation == TaskPresentation.Board ? "active" : null)"
                                    aria-pressed="@(Presentation == TaskPresentation.Board)" @onclick="ShowBoard">Board</button>
                        </div>
                    }
                </div>

                @if (ActiveTab != TaskListTab.Projects)
                {
                    <div class="task-list-tools" aria-label="Search, filter, and sort tasks">
                        <label class="task-search">
                            <span aria-hidden="true">⌕</span>
                            <input type="search" placeholder="Search tasks…" aria-label="Search tasks by title"
                                   @bind="SearchText" @bind:event="oninput" @bind:after="ApplyFiltersAsync" />
                        </label>
                        <TaskAssigneeFilter Options="@AssigneeOptions" Value="@AssigneeFilter"
                                            ValueChanged="ApplyAssigneeFilterAsync" />
                        <label><span>Work</span><select @bind="WorkStatusFilter" @bind:after="ApplyFiltersAsync">
                            <option value="">All</option><option value="ToDo">To Do</option>
                            <option value="InProgress">In Progress</option><option value="Done">Done</option>
                        </select></label>
                        <label><span>Assignment</span><select @bind="AssignmentStatusFilter" @bind:after="ApplyFiltersAsync">
                            <option value="">All</option><option value="Pending">Pending</option>
                            <option value="Accepted">Accepted</option><option value="DeadlineChangeRequested">Deadline requested</option>
                        </select></label>
                        <label><span>Priority</span><select @bind="PriorityFilter" @bind:after="ApplyFiltersAsync">
                            <option value="">All</option><option value="None">No priority</option>
                            <option value="Low">Low</option><option value="Medium">Medium</option>
                            <option value="High">High</option><option value="Urgent">Urgent</option>
                        </select></label>
                        <label><span>Deadline</span><select @bind="DeadlineFilter" @bind:after="ApplyFiltersAsync">
                            <option value="All">All</option><option value="NoDeadline">No deadline</option>
                            <option value="Overdue">Overdue</option>
                            <option value="Today">Today</option><option value="ThisWeek">This week</option>
                        </select></label>
                        <label><span>Sort</span><select @bind="SortOrder" @bind:after="ApplyFiltersAsync">
                            <option value="DeadlineNearest">Deadline: nearest</option>
                            <option value="PriorityHighest">Priority: highest</option>
                            <option value="Newest">Newest</option>
                        </select></label>
                        @if (HasActiveFilters)
                        {
                            <button class="clear-task-filters" type="button" @onclick="ClearFiltersAsync">Clear filters</button>
                        }
                    </div>
                }

                @if (ActiveTab == TaskListTab.Projects)
                {
                    @if (ShowProjectDetails)
                    {
                        <ProjectDetailsView @ref="ProjectDetailsComponent" Details="@SelectedProject" IsLoading="@IsProjectDetailsLoading"
                                            ErrorMessage="@ProjectDetailsError" RefreshKey="@ProjectTasksRefreshKey"
                                            OpenTaskRequested="OpenTaskAsync" BackRequested="CloseProjectDetails"
                                            TaskChanged="RefreshAfterProjectBoardChangeAsync" />
                    }
                    else
                    {
                        <div class="project-list-tools" aria-label="Search projects">
                            <label class="project-search">
                                <span aria-hidden="true">⌕</span>
                                <input type="search" placeholder="Search projects…" aria-label="Search projects by name"
                                       @bind="ProjectSearchText" @bind:event="oninput" @bind:after="ApplyProjectSearchAsync" />
                            </label>
                            <span>Shared projects are visible to every signed-in LUMA user.</span>
                        </div>

                        @if (IsProjectsLoading)
                        {
                            <div class="tasks-loading" role="status">
                                <span aria-hidden="true"></span>
                                <strong>Loading projects…</strong>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(ProjectLoadError))
                        {
                            <div class="tasks-load-error" role="alert">
                                <strong>Projects could not be loaded</strong>
                                <p>@ProjectLoadError</p>
                            </div>
                        }
                        else if (Projects.Count == 0)
                        {
                            <div class="projects-empty">
                                <span aria-hidden="true">◇</span>
                                <strong>@(string.IsNullOrWhiteSpace(ProjectSearchText) ? "No projects yet." : "No projects match your search.")</strong>
                                <small>@(string.IsNullOrWhiteSpace(ProjectSearchText) ? "Create the first shared project workspace." : "Try a different project name.")</small>
                            </div>
                        }
                        else
                        {
                            <div class="project-list">
                                @foreach (var project in Projects)
                                {
                                    <button type="button" class="project-list-card" @onclick="() => OpenProjectAsync(project.Id)">
                                        <span class="project-card-mark" aria-hidden="true">
                                            <svg viewBox="0 0 24 24"><path d="M4 7.5h6l2 2h8v9.5H4z"></path><path d="M4 7.5V5h6l2 2h8v2.5"></path></svg>
                                        </span>
                                        <span class="project-card-copy">
                                            <strong>@project.Name</strong>
                                            <small>@(string.IsNullOrWhiteSpace(project.Description) ? "No description" : project.Description)</small>
                                            <span>Created by <b>@project.CreatedByName</b></span>
                                            <span class="project-card-count">@ProjectCountLabel(project)</span>
                                        </span>
                                        <span class="project-card-arrow" aria-hidden="true">›</span>
                                    </button>
                                }
                            </div>
                        }
                    }
                }
                else if (IsLoading)
                {
                    <div class="tasks-loading" role="status">
                        <span aria-hidden="true"></span>
                        <strong>Loading your tasks…</strong>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(LoadError))
                {
                    <div class="tasks-load-error" role="alert">
                        <strong>Tasks could not be loaded</strong>
                        <p>@LoadError</p>
                    </div>
                }
                else if (Presentation == TaskPresentation.Board)
                {
                    var boardItems = CurrentBoardItems();
                    <div class="task-board" aria-label="Task Board">
                        @foreach (var status in BoardStatuses)
                        {
                            var columnItems = boardItems.Where(item => item.WorkStatus == status).ToArray();
                            <section class="task-board-column" data-task-drop="@status" aria-label="@WorkStatusLabel(status) tasks">
                                <header>
                                    <h2>@WorkStatusLabel(status)</h2>
                                    <span>@columnItems.Length</span>
                                </header>
                                <div class="task-board-column-body">
                                    @if (columnItems.Length == 0)
                                    {
                                        <div class="task-board-empty">No tasks here</div>
                                    }
                                    else
                                    {
                                        @foreach (var task in columnItems)
                                        {
                                            var deadlineClass = DeadlineClass(task.Deadline);
                                            <button type="button" class="task-board-card @deadlineClass"
                                                    draggable="@(task.CanDrag ? "true" : "false")"
                                                    data-task-board-card="true"
                                                    data-task-drag="@(task.CanDrag ? task.Id.ToString("D") : null)"
                                                    data-task-version="@(task.CanDrag ? task.Version.ToString("D") : null)"
                                                    data-work-status="@(task.CanDrag ? task.WorkStatus.ToString() : null)"
                                                    title="@(task.CanDrag ? "Drag to the next work stage" : "Open task details")"
                                                    @onclick="() => OpenTaskAsync(task.Id)">
                                                <strong>@task.Title</strong>
                                                <span class="task-board-person">@task.RelationshipLabel</span>
                                                @if (!string.IsNullOrWhiteSpace(task.ProjectName))
                                                {
                                                    <span class="task-project-chip">◇ @task.ProjectName</span>
                                                }
                                                <span class="task-board-card-meta">
                                                    <span class="task-priority-badge @PriorityClass(task.Priority)">
                                                        @if (task.Priority != TaskPriority.None) { <i aria-hidden="true">●</i> }
                                                        @PriorityLabel(task.Priority)
                                                    </span>
                                                    <span class="task-status-badge @StatusClass(task.AssignmentStatus, task.IsInvited, task.IsUnassigned)">@StatusLabel(task.AssignmentStatus, task.IsInvited, task.IsUnassigned)</span>
                                                </span>
                                                <span class="task-board-deadline @deadlineClass">
                                                    @if (task.Deadline is { } boardDeadline)
                                                    {
                                                        <time datetime="@boardDeadline.ToString("yyyy-MM-dd")">@FormatDeadline(boardDeadline)</time>
                                                    }
                                                    else
                                                    {
                                                        <span>No deadline</span>
                                                    }
                                                </span>
                                            </button>
                                        }
                                    }
                                </div>
                            </section>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(BoardError))
                    {
                        <div class="task-board-message error" role="alert">@BoardError</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(BoardNotice))
                    {
                        <div class="task-board-message" role="status">@BoardNotice</div>
                    }
                }
                else
                {
                    <div role="tabpanel" class="task-panel" aria-label="Related Tasks">
                        @if (RelatedTasks.Count == 0)
                        {
                            <TaskEmptyState Message="@(HasActiveFilters ? "No tasks match these filters." : "No company tasks yet.")" />
                        }
                        else
                        {
                            <div class="task-list">
                                @foreach (var task in RelatedTasks)
                                {
                                    var deadlineClass = DeadlineClass(task.Deadline);
                                    <button type="button" class="task-list-card @deadlineClass" @onclick="() => OpenTaskAsync(task.Id)">
                                        <span class="task-card-mark @RelationshipClass(task)" aria-hidden="true">@RelationshipMark(task)</span>
                                        <span class="task-card-copy">
                                            <strong>@task.Title</strong>
                                            <span class="task-card-meta">
                                                <small>@RelationshipLabel(task)</small>
                                                @if (!string.IsNullOrWhiteSpace(task.ProjectName))
                                                {
                                                    <span class="task-project-chip">◇ @task.ProjectName</span>
                                                }
                                                <span class="task-status-badge @StatusClass(task.AssignmentStatus, task.IsInvited, IsUnassigned(task))">@StatusLabel(task.AssignmentStatus, task.IsInvited, IsUnassigned(task))</span>
                                                <span class="task-work-badge @WorkStatusClass(task.WorkStatus)">@WorkStatusLabel(task.WorkStatus)</span>
                                                <span class="task-priority-badge @PriorityClass(task.Priority)">@PriorityLabel(task.Priority)</span>
                                            </span>
                                        </span>
                                        <span class="task-card-deadline @deadlineClass">
                                            <small>Deadline</small>
                                            @if (task.Deadline is { } deadline)
                                            {
                                                <time datetime="@deadline.ToString("yyyy-MM-dd")">@FormatDeadline(deadline)</time>
                                            }
                                            else
                                            {
                                                <span>No deadline</span>
                                            }
                                        </span>
                                        <span class="task-card-arrow" aria-hidden="true">›</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </section>
    </main>
</div>

@if (ShowCreateTask)
{
    <TaskCreateDialog CancelRequested="CloseCreateTask" Created="HandleTaskCreated" ErrorMessage="@OperationError" />
}

@if (ShowCreateProject)
{
    <ProjectCreateDialog CancelRequested="CloseCreateProject" Created="HandleProjectCreated"
                         IsSubmitting="@IsCreatingProject" ErrorMessage="@ProjectOperationError" />
}

@if (ShowTaskDetails)
{
    <TaskDetailsDialog Details="@SelectedTask" IsLoading="@IsDetailsLoading"
                       ErrorMessage="@DetailsError" ActionError="@DetailsActionError"
                       NoticeMessage="@DetailsNotice"
                       IsAccepting="@IsAcceptingTask" IsTaking="@IsTakingTask" IsReviewingDeadline="@IsReviewingDeadline"
                       IsChangingWorkStatus="@IsChangingWorkStatus"
                       AcceptRequested="AcceptTaskAsync" TakeRequested="TakeTaskAsync" DeadlineChangeRequested="OpenDeadlineRequest"
                       ApproveDeadlineChangeRequested="ApproveDeadlineChangeAsync"
                       DeclineDeadlineChangeRequested="DeclineDeadlineChangeAsync"
                       EditRequested="OpenTaskEdit"
                       WorkStatusChangeRequested="ChangeWorkStatusAsync"
                       CloseRequested="CloseTaskDetails" />
}

@if (ShowTaskEdit && SelectedTask is not null)
{
    <TaskEditDialog Details="@SelectedTask" IsSubmitting="@IsSavingTaskEdit" ErrorMessage="@TaskEditError"
                    CancelRequested="CloseTaskEdit" SubmitRequested="SaveTaskEditAsync" />
}

@if (ShowDeadlineRequest && SelectedTask?.Deadline is { } selectedDeadline)
{
    <TaskDeadlineRequestDialog TaskId="@SelectedTask.Id" CurrentDeadline="@selectedDeadline"
                               ErrorMessage="@DeadlineRequestError" IsSubmitting="@IsSubmittingDeadlineRequest"
                               CancelRequested="CloseDeadlineRequest" SubmitRequested="SubmitDeadlineRequestAsync" />
}

@code {
    [SupplyParameterFromQuery(Name = "task")] public Guid? LinkedTaskId { get; set; }
    [SupplyParameterFromQuery(Name = "taskInvitationError")] public string? TaskInvitationError { get; set; }

    private string FeedbackTitle = string.Empty;
    private string FeedbackMessage = string.Empty;
    private string OperationError = string.Empty;
    private string LoadError = string.Empty;
    private string DetailsError = string.Empty;
    private string DetailsActionError = string.Empty;
    private string DetailsNotice = string.Empty;
    private string DeadlineRequestError = string.Empty;
    private bool ShowCreateTask;
    private bool ShowCreateProject;
    private bool IsCreatingProject;
    private string ProjectOperationError = string.Empty;
    private string ProjectLoadError = string.Empty;
    private string ProjectDetailsError = string.Empty;
    private bool IsProjectsLoading = true;
    private bool ShowProjectDetails;
    private bool IsProjectDetailsLoading;
    private string ProjectSearchText = string.Empty;
    private IReadOnlyList<ProjectSummary> Projects = [];
    private ProjectDetails? SelectedProject;
    private ProjectDetailsView? ProjectDetailsComponent;
    private long ProjectLoadGeneration;
    private long ProjectTasksRefreshKey;
    private bool ShowTaskDetails;
    private bool IsLoading = true;
    private bool IsDetailsLoading;
    private bool IsAcceptingTask;
    private bool IsTakingTask;
    private bool ShowDeadlineRequest;
    private bool IsSubmittingDeadlineRequest;
    private bool IsReviewingDeadline;
    private bool ShowTaskEdit;
    private bool IsSavingTaskEdit;
    private bool IsChangingWorkStatus;
    private string TaskEditError = string.Empty;
    private string BoardError = string.Empty;
    private string BoardNotice = string.Empty;
    private TaskListTab ActiveTab = TaskListTab.Tasks;
    private IReadOnlyList<RelatedLumaTask> RelatedTasks = [];
    private IReadOnlyList<TaskAssigneeFilterOption> AssigneeOptions = [];
    private LumaTaskDetails? SelectedTask;
    private TaskPresentation Presentation = TaskPresentation.List;
    private DotNetObjectReference<Tasks>? BoardDragReference;
    private static readonly TaskWorkStatus[] BoardStatuses =
        [TaskWorkStatus.ToDo, TaskWorkStatus.InProgress, TaskWorkStatus.Done];
    private string SearchText = string.Empty;
    private string WorkStatusFilter = string.Empty;
    private string AssignmentStatusFilter = string.Empty;
    private string PriorityFilter = string.Empty;
    private TaskAssigneeFilterSelection AssigneeFilter = new([], false);
    private string DeadlineFilter = nameof(TaskDeadlineFilter.All);
    private string SortOrder = nameof(TaskSortOrder.DeadlineNearest);
    private long TaskLoadGeneration;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(SearchText) ||
        WorkStatusFilter.Length > 0 ||
        AssignmentStatusFilter.Length > 0 ||
        PriorityFilter.Length > 0 ||
        AssigneeFilter.UserIds.Count > 0 ||
        AssigneeFilter.IncludeUnassigned ||
        DeadlineFilter != nameof(TaskDeadlineFilter.All) ||
        SortOrder != nameof(TaskSortOrder.DeadlineNearest);

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadTasksAsync(), LoadProjectsAsync(), LoadAssigneeOptionsAsync());
        if (LinkedTaskId is not null)
            await OpenTaskAsync(LinkedTaskId.Value);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        BoardDragReference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("lumaTaskBoardDrag.initialize", BoardDragReference);
    }

    private void OpenCreateTask()
    {
        FeedbackTitle = string.Empty;
        FeedbackMessage = string.Empty;
        OperationError = string.Empty;
        ShowCreateTask = true;
    }

    private void OpenPrimaryCreate()
    {
        if (ActiveTab == TaskListTab.Projects)
            OpenCreateProject();
        else
            OpenCreateTask();
    }

    private void CloseCreateTask() => ShowCreateTask = false;

    private async Task HandleTaskCreated(CreateLumaTaskRequest request)
    {
        OperationError = string.Empty;
        try
        {
            await TaskStore.CreateAsync(request);
            ShowCreateTask = false;
            FeedbackTitle = "Task created";
            FeedbackMessage = TaskStore.LastNotice ?? $"“{request.Title}” was saved successfully.";
            await LoadTasksAsync();
        }
        catch (Exception exception) when (exception is System.ComponentModel.DataAnnotations.ValidationException or UnauthorizedAccessException)
        {
            OperationError = exception.Message;
        }
    }

    private void OpenCreateProject()
    {
        FeedbackTitle = string.Empty;
        FeedbackMessage = string.Empty;
        ProjectOperationError = string.Empty;
        ShowCreateProject = true;
    }

    private void CloseCreateProject()
    {
        if (IsCreatingProject) return;
        ShowCreateProject = false;
        ProjectOperationError = string.Empty;
    }

    private async Task HandleProjectCreated(CreateProjectRequest request)
    {
        ProjectOperationError = string.Empty;
        IsCreatingProject = true;
        try
        {
            await ProjectStore.CreateAsync(request);
            ShowCreateProject = false;
            FeedbackTitle = "Project created";
            FeedbackMessage = $"“{request.Name}” is ready.";
            await LoadProjectsAsync();
        }
        catch (Exception exception) when (exception is System.ComponentModel.DataAnnotations.ValidationException or UnauthorizedAccessException)
        {
            ProjectOperationError = exception.Message;
        }
        finally
        {
            IsCreatingProject = false;
        }
    }

    private void DismissFeedback()
    {
        FeedbackTitle = string.Empty;
        FeedbackMessage = string.Empty;
    }

    private async Task LoadTasksAsync(bool showLoading = true)
    {
        var generation = ++TaskLoadGeneration;
        if (showLoading) IsLoading = true;
        LoadError = string.Empty;
        try
        {
            var tasks = await TaskStore.LoadRelatedAsync(CurrentListQuery());
            if (generation != TaskLoadGeneration) return;
            RelatedTasks = tasks;
            if (ShowProjectDetails && SelectedProject is not null)
            {
                SelectedProject = await ProjectStore.LoadDetailsAsync(SelectedProject.Id);
                ProjectTasksRefreshKey++;
                await LoadProjectsAsync(showLoading: false);
            }
        }
        catch (UnauthorizedAccessException exception)
        {
            LoadError = exception.Message;
        }
        finally
        {
            if (generation == TaskLoadGeneration) IsLoading = false;
        }
    }

    private async Task LoadProjectsAsync(bool showLoading = true)
    {
        var generation = ++ProjectLoadGeneration;
        if (showLoading) IsProjectsLoading = true;
        ProjectLoadError = string.Empty;
        try
        {
            var projects = await ProjectStore.LoadAsync(ProjectSearchText);
            if (generation != ProjectLoadGeneration) return;
            Projects = projects;
        }
        catch (UnauthorizedAccessException exception)
        {
            ProjectLoadError = exception.Message;
        }
        finally
        {
            if (generation == ProjectLoadGeneration) IsProjectsLoading = false;
        }
    }

    private Task ApplyProjectSearchAsync() => LoadProjectsAsync(showLoading: false);

    private Task ApplyFiltersAsync() => LoadTasksAsync(showLoading: false);

    private async Task ApplyAssigneeFilterAsync(TaskAssigneeFilterSelection selection)
    {
        AssigneeFilter = selection;
        await LoadTasksAsync(showLoading: false);
    }

    private async Task LoadAssigneeOptionsAsync()
    {
        try
        {
            AssigneeOptions = await TaskStore.LoadAssigneeFilterOptionsAsync();
        }
        catch (UnauthorizedAccessException exception)
        {
            LoadError = exception.Message;
        }
    }

    private async Task ClearFiltersAsync()
    {
        SearchText = string.Empty;
        WorkStatusFilter = string.Empty;
        AssignmentStatusFilter = string.Empty;
        PriorityFilter = string.Empty;
        AssigneeFilter = new TaskAssigneeFilterSelection([], false);
        DeadlineFilter = nameof(TaskDeadlineFilter.All);
        SortOrder = nameof(TaskSortOrder.DeadlineNearest);
        await LoadTasksAsync(showLoading: false);
    }

    private TaskListQuery CurrentListQuery() => new(
        Search: SearchText,
        WorkStatus: ParseOptional<TaskWorkStatus>(WorkStatusFilter),
        AssignmentStatus: ParseOptional<TaskAssignmentStatus>(AssignmentStatusFilter),
        Priority: ParseOptional<TaskPriority>(PriorityFilter),
        Deadline: Enum.TryParse<TaskDeadlineFilter>(DeadlineFilter, out var deadline) ? deadline : TaskDeadlineFilter.All,
        Sort: Enum.TryParse<TaskSortOrder>(SortOrder, out var sort) ? sort : TaskSortOrder.DeadlineNearest,
        AssigneeIds: AssigneeFilter.UserIds,
        IncludeUnassigned: AssigneeFilter.IncludeUnassigned);

    private static TEnum? ParseOptional<TEnum>(string value) where TEnum : struct, Enum =>
        Enum.TryParse<TEnum>(value, out var parsed) ? parsed : null;

    private void ShowTasks()
    {
        ActiveTab = TaskListTab.Tasks;
        CloseProjectDetails();
        ClearBoardMessages();
    }

    private void ShowProjects()
    {
        ActiveTab = TaskListTab.Projects;
        CloseTaskDetails();
        ClearBoardMessages();
    }

    private void ShowList()
    {
        Presentation = TaskPresentation.List;
        ClearBoardMessages();
    }

    private void ShowBoard()
    {
        Presentation = TaskPresentation.Board;
        ClearBoardMessages();
    }

    [JSInvokable]
    public async Task HandleTaskBoardDrop(string taskIdValue, string targetStatusValue, string versionValue)
    {
        if (ActiveTab == TaskListTab.Projects && ShowProjectDetails && ProjectDetailsComponent is not null)
        {
            await ProjectDetailsComponent.HandleBoardDropAsync(taskIdValue, targetStatusValue, versionValue);
            return;
        }

        BoardError = string.Empty;
        BoardNotice = string.Empty;
        if (!Guid.TryParse(taskIdValue, out var taskId) ||
            !Guid.TryParse(versionValue, out var version) ||
            !Enum.TryParse<TaskWorkStatus>(targetStatusValue, out var targetStatus))
        {
            BoardError = "The task drop could not be understood. Reload the page and try again.";
            return;
        }

        var task = CurrentBoardItems().SingleOrDefault(item => item.Id == taskId);
        if (task is null || !task.CanDrag || !IsForwardTransition(task.WorkStatus, targetStatus))
        {
            BoardError = "Tasks can move only forward after the Task Doer accepts them.";
            return;
        }

        try
        {
            var updated = await TaskStore.ChangeWorkStatusAsync(
                taskId, new ChangeTaskWorkStatusRequest(targetStatus, version));
            if (SelectedTask?.Id == taskId) SelectedTask = updated;
            BoardNotice = TaskStore.LastNotice ?? $"Task moved to {WorkStatusLabel(targetStatus)}.";
        }
        catch (Exception exception) when (exception is LumaTaskNotFoundException or UnauthorizedAccessException or System.ComponentModel.DataAnnotations.ValidationException)
        {
            BoardError = exception.Message;
        }
        finally
        {
            await LoadTasksAsync(showLoading: false);
        }
    }

    [JSInvokable]
    public Task HandleInvalidTaskBoardDrop()
    {
        if (ActiveTab == TaskListTab.Projects && ShowProjectDetails && ProjectDetailsComponent is not null)
        {
            ProjectDetailsComponent.ShowInvalidBoardDrop();
            return Task.CompletedTask;
        }

        BoardNotice = string.Empty;
        BoardError = "Tasks can move only forward: To Do → In Progress → Done.";
        return Task.CompletedTask;
    }

    private void ClearBoardMessages()
    {
        BoardError = string.Empty;
        BoardNotice = string.Empty;
    }

    private async Task RefreshAfterProjectBoardChangeAsync()
    {
        if (SelectedProject is null) return;

        RelatedTasks = await TaskStore.LoadRelatedAsync(CurrentListQuery());
        SelectedProject = await ProjectStore.LoadDetailsAsync(SelectedProject.Id);
        await LoadProjectsAsync(showLoading: false);
    }

    private async Task OpenProjectAsync(Guid projectId)
    {
        SelectedProject = null;
        ProjectDetailsError = string.Empty;
        IsProjectDetailsLoading = true;
        ShowProjectDetails = true;
        StateHasChanged();

        try
        {
            SelectedProject = await ProjectStore.LoadDetailsAsync(projectId);
            ProjectTasksRefreshKey++;
        }
        catch (ProjectNotFoundException exception)
        {
            ProjectDetailsError = exception.Message;
            await LoadProjectsAsync();
        }
        catch (UnauthorizedAccessException exception)
        {
            ProjectDetailsError = exception.Message;
        }
        finally
        {
            IsProjectDetailsLoading = false;
        }
    }

    private void CloseProjectDetails()
    {
        ShowProjectDetails = false;
        IsProjectDetailsLoading = false;
        SelectedProject = null;
        ProjectDetailsError = string.Empty;
    }

    private async Task OpenTaskAsync(Guid taskId)
    {
        SelectedTask = null;
        DetailsError = string.Empty;
        DetailsActionError = string.Empty;
        DetailsNotice = string.Empty;
        ShowDeadlineRequest = false;
        ShowTaskEdit = false;
        DeadlineRequestError = string.Empty;
        IsDetailsLoading = true;
        ShowTaskDetails = true;
        StateHasChanged();

        try
        {
            SelectedTask = await TaskStore.LoadDetailsAsync(taskId);
        }
        catch (LumaTaskNotFoundException exception)
        {
            DetailsError = exception.Message;
            await LoadTasksAsync();
        }
        catch (UnauthorizedAccessException exception)
        {
            DetailsError = exception.Message;
        }
        finally
        {
            IsDetailsLoading = false;
        }
    }

    private void CloseTaskDetails()
    {
        ShowTaskDetails = false;
        SelectedTask = null;
        DetailsError = string.Empty;
        DetailsActionError = string.Empty;
        DetailsNotice = string.Empty;
        ShowTaskEdit = false;
        TaskEditError = string.Empty;
    }

    private async Task AcceptTaskAsync(Guid taskId)
    {
        DetailsActionError = string.Empty;
        DetailsNotice = string.Empty;
        IsAcceptingTask = true;
        try
        {
            SelectedTask = await TaskStore.AcceptAsync(taskId);
            DetailsNotice = TaskStore.LastNotice ?? string.Empty;
            await LoadTasksAsync();
        }
        catch (Exception exception) when (exception is LumaTaskNotFoundException or UnauthorizedAccessException or System.ComponentModel.DataAnnotations.ValidationException)
        {
            DetailsActionError = exception.Message;
        }
        finally
        {
            IsAcceptingTask = false;
        }
    }

    private async Task TakeTaskAsync(Guid taskId)
    {
        if (SelectedTask?.Id != taskId) return;
        DetailsActionError = string.Empty;
        DetailsNotice = string.Empty;
        IsTakingTask = true;
        try
        {
            SelectedTask = await TaskStore.TakeAsync(taskId, new TakeLumaTaskRequest(SelectedTask.Version));
            DetailsNotice = "Task assigned to you and accepted.";
            await LoadTasksAsync();
        }
        catch (Exception exception) when (exception is LumaTaskNotFoundException or UnauthorizedAccessException or System.ComponentModel.DataAnnotations.ValidationException)
        {
            DetailsActionError = exception.Message;
        }
        finally
        {
            IsTakingTask = false;
        }
    }

    private void OpenDeadlineRequest(Guid taskId)
    {
        if (SelectedTask?.Id != taskId) return;
        DetailsActionError = string.Empty;
        DetailsNotice = string.Empty;
        DeadlineRequestError = string.Empty;
        ShowDeadlineRequest = true;
    }

    private void CloseDeadlineRequest()
    {
        ShowDeadlineRequest = false;
        DeadlineRequestError = string.Empty;
    }

    private async Task SubmitDeadlineRequestAsync(RequestTaskDeadlineChange request)
    {
        if (SelectedTask is null) return;
        DeadlineRequestError = string.Empty;
        IsSubmittingDeadlineRequest = true;
        try
        {
            SelectedTask = await TaskStore.RequestDeadlineChangeAsync(SelectedTask.Id, request);
            ShowDeadlineRequest = false;
            DetailsNotice = TaskStore.LastNotice ?? "Deadline change requested. The Task Maker can now review it.";
            await LoadTasksAsync();
        }
        catch (Exception exception) when (exception is LumaTaskNotFoundException or UnauthorizedAccessException or System.ComponentModel.DataAnnotations.ValidationException)
        {
            DeadlineRequestError = exception.Message;
        }
        finally
        {
            IsSubmittingDeadlineRequest = false;
        }
    }

    private Task ApproveDeadlineChangeAsync(Guid taskId) => ReviewDeadlineChangeAsync(taskId, approve: true);
    private Task DeclineDeadlineChangeAsync(Guid taskId) => ReviewDeadlineChangeAsync(taskId, approve: false);

    private void OpenTaskEdit(Guid taskId)
    {
        if (SelectedTask?.Id != taskId || !SelectedTask.CanEdit) return;
        DetailsActionError = string.Empty;
        DetailsNotice = string.Empty;
        TaskEditError = string.Empty;
        ShowTaskEdit = true;
    }

    private void CloseTaskEdit()
    {
        ShowTaskEdit = false;
        TaskEditError = string.Empty;
    }

    private async Task SaveTaskEditAsync(UpdateLumaTaskContentRequest request)
    {
        if (SelectedTask is null) return;
        TaskEditError = string.Empty;
        IsSavingTaskEdit = true;
        try
        {
            SelectedTask = await TaskStore.UpdateContentAsync(SelectedTask.Id, request);
            ShowTaskEdit = false;
            DetailsNotice = TaskStore.LastNotice ?? "Task details updated.";
            await LoadTasksAsync();
        }
        catch (Exception exception) when (exception is LumaTaskNotFoundException or UnauthorizedAccessException or System.ComponentModel.DataAnnotations.ValidationException)
        {
            TaskEditError = exception.Message;
        }
        finally
        {
            IsSavingTaskEdit = false;
        }
    }

    private async Task ChangeWorkStatusAsync(TaskWorkStatus status)
    {
        if (SelectedTask is null) return;
        DetailsActionError = string.Empty;
        DetailsNotice = string.Empty;
        IsChangingWorkStatus = true;
        try
        {
            SelectedTask = await TaskStore.ChangeWorkStatusAsync(
                SelectedTask.Id,
                new ChangeTaskWorkStatusRequest(status, SelectedTask.Version));
            DetailsNotice = TaskStore.LastNotice ?? $"Task progress changed to {WorkStatusLabel(status)}.";
            await LoadTasksAsync();
        }
        catch (Exception exception) when (exception is LumaTaskNotFoundException or UnauthorizedAccessException or System.ComponentModel.DataAnnotations.ValidationException)
        {
            DetailsActionError = exception.Message;
        }
        finally
        {
            IsChangingWorkStatus = false;
        }
    }

    private async Task ReviewDeadlineChangeAsync(Guid taskId, bool approve)
    {
        DetailsActionError = string.Empty;
        DetailsNotice = string.Empty;
        IsReviewingDeadline = true;
        try
        {
            SelectedTask = approve
                ? await TaskStore.ApproveDeadlineChangeAsync(taskId)
                : await TaskStore.DeclineDeadlineChangeAsync(taskId);
            DetailsNotice = TaskStore.LastNotice ?? (approve
                ? "Deadline change approved. The assignment is now accepted."
                : "Deadline change declined. The assignment is pending again.");
            await LoadTasksAsync();
        }
        catch (Exception exception) when (exception is LumaTaskNotFoundException or UnauthorizedAccessException or System.ComponentModel.DataAnnotations.ValidationException)
        {
            DetailsActionError = exception.Message;
        }
        finally
        {
            IsReviewingDeadline = false;
        }
    }

    private static string FormatDeadline(DateOnly? deadline)
    {
        if (deadline is null) return "No deadline";
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (deadline.Value == today) return "Today";
        if (deadline.Value < today) return $"Overdue · {deadline.Value:MMM d, yyyy}";
        return deadline.Value.ToString("MMM d, yyyy");
    }

    private static string DeadlineClass(DateOnly? deadline)
    {
        if (deadline is null) return "no-deadline";
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (deadline.Value < today) return "overdue";
        return deadline.Value == today ? "due-today" : string.Empty;
    }

    private static string StatusClass(TaskAssignmentStatus status, bool isInvited = false, bool isUnassigned = false) =>
        isUnassigned ? "unassigned" : isInvited ? "invited" :
        status switch
        {
            TaskAssignmentStatus.Accepted => "accepted",
            TaskAssignmentStatus.DeadlineChangeRequested => "deadline-requested",
            _ => "pending"
        };

    private static string StatusLabel(TaskAssignmentStatus status, bool isInvited = false, bool isUnassigned = false) =>
        isUnassigned ? "Unassigned" : isInvited ? "Invited" :
        status switch
        {
            TaskAssignmentStatus.Accepted => "Accepted",
            TaskAssignmentStatus.DeadlineChangeRequested => "Deadline requested",
            _ => "Pending"
        };

    private static string WorkStatusClass(TaskWorkStatus status) => status switch
    {
        TaskWorkStatus.InProgress => "in-progress",
        TaskWorkStatus.Done => "done",
        _ => "to-do"
    };

    private static string WorkStatusLabel(TaskWorkStatus status) => status switch
    {
        TaskWorkStatus.InProgress => "In Progress",
        TaskWorkStatus.Done => "Done",
        _ => "To Do"
    };

    private static string PriorityClass(TaskPriority priority) => priority.ToString().ToLowerInvariant();
    private static string PriorityLabel(TaskPriority priority) => priority == TaskPriority.None ? "No priority" : priority.ToString();
    private static string ProjectCountLabel(ProjectSummary project) => project.TaskCount == 0
        ? "0 tasks"
        : $"{project.TaskCount} tasks · {project.DoneTaskCount} done";

    private static string RelationshipLabel(RelatedLumaTask task) =>
        IsUnassigned(task)
            ? task.IsCreatedByCurrentUser ? "Created by you · Unassigned" : $"Unassigned · Created by {task.CreatorName}"
            : task.IsCreatedByCurrentUser && task.IsAssignedToCurrentUser
            ? "Personal task"
            : task.IsAssignedToCurrentUser
                ? $"Assigned to you by {task.CreatorName}"
                : task.IsCreatedByCurrentUser
                    ? $"Assigned by you to {task.AssigneeName}"
                    : $"{task.CreatorName} → {task.AssigneeName}";

    private static string RelationshipClass(RelatedLumaTask task) =>
        IsUnassigned(task)
            ? "company"
            : task.IsCreatedByCurrentUser && task.IsAssignedToCurrentUser
            ? "personal"
            : task.IsAssignedToCurrentUser
                ? "assigned"
                : task.IsCreatedByCurrentUser ? "created" : "company";

    private static string RelationshipMark(RelatedLumaTask task) =>
        IsUnassigned(task)
            ? "—"
            : task.IsCreatedByCurrentUser && task.IsAssignedToCurrentUser
            ? "•"
            : task.IsAssignedToCurrentUser
                ? "✓"
                : task.IsCreatedByCurrentUser ? "↗" : "◇";

    private IReadOnlyList<BoardTaskItem> CurrentBoardItems() => RelatedTasks
        .Select(task => new BoardTaskItem(
            task.Id, task.Title, RelationshipLabel(task), task.ProjectName, task.Deadline,
            task.AssignmentStatus, task.WorkStatus, task.Priority, task.Version, task.IsInvited,
            IsUnassigned(task), CanDrag(task.CanManageWorkStatus, task.AssignmentStatus, task.WorkStatus)))
        .ToArray();

    private static bool IsUnassigned(RelatedLumaTask task) => task.AssigneeId is null && !task.IsInvited;

    private static bool CanDrag(bool canManage, TaskAssignmentStatus assignmentStatus, TaskWorkStatus workStatus) =>
        canManage && assignmentStatus == TaskAssignmentStatus.Accepted && workStatus != TaskWorkStatus.Done;

    private static bool IsForwardTransition(TaskWorkStatus current, TaskWorkStatus target) =>
        (current, target) is
            (TaskWorkStatus.ToDo, TaskWorkStatus.InProgress) or
            (TaskWorkStatus.InProgress, TaskWorkStatus.Done);

    public async ValueTask DisposeAsync()
    {
        if (BoardDragReference is null) return;
        try { await JS.InvokeVoidAsync("lumaTaskBoardDrag.dispose"); }
        catch (JSDisconnectedException) { }
        BoardDragReference?.Dispose();
    }

    private enum TaskListTab { Tasks, Projects }
    private enum TaskPresentation { List, Board }
    private sealed record BoardTaskItem(
        Guid Id,
        string Title,
        string RelationshipLabel,
        string ProjectName,
        DateOnly? Deadline,
        TaskAssignmentStatus AssignmentStatus,
        TaskWorkStatus WorkStatus,
        TaskPriority Priority,
        Guid Version,
        bool IsInvited,
        bool IsUnassigned,
        bool CanDrag);
}
