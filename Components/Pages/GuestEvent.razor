@page "/guest-event"
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@using global::Calendar.Models
@using global::Calendar.Services
@inject IEventInvitationService InvitationService

<PageTitle>Shared event · Luma</PageTitle>
<HeadContent><meta name="robots" content="noindex,nofollow" /></HeadContent>

<main class="guest-event-page">
    <section class="guest-event-card">
        <header class="guest-event-header">
            <a class="auth-brand" href="/login"><span class="brand-mark">L</span><span>Luma</span></a>
            <span>Guest view</span>
        </header>
        @if (Result?.Status == InvitationStatus.Valid && Result.Event is { } sharedEvent)
        {
            <div class="guest-event-accent"></div>
            <div class="guest-event-content">
                <span class="eyebrow">SHARED EVENT</span>
                <h1>@sharedEvent.Title</h1>
                <dl class="guest-event-details">
                    <div><dt>Date</dt><dd>@EventDate(sharedEvent)</dd></div>
                    <div><dt>Time</dt><dd>@EventTime(sharedEvent)</dd></div>
                    <div><dt>Organizer</dt><dd>@sharedEvent.OrganizerName</dd></div>
                </dl>
                @if (!string.IsNullOrWhiteSpace(sharedEvent.Description))
                {
                    <div class="guest-event-description">@sharedEvent.Description</div>
                }
                @if (MeetingUrlHelper.TryGetSafeUri(sharedEvent.MeetingUrl, out var meetingUri))
                {
                    <a class="guest-meeting-action" href="@meetingUri!.AbsoluteUri" target="_blank" rel="noopener noreferrer">
                        ↗ @MeetingUrlHelper.JoinLabel(sharedEvent.MeetingUrl)
                    </a>
                }
                <section class="rsvp-panel guest-rsvp-panel" aria-labelledby="guest-rsvp-heading">
                    <div class="rsvp-heading">
                        <div>
                            <span class="eyebrow">YOUR RESPONSE</span>
                            <h2 id="guest-rsvp-heading">Will you attend?</h2>
                        </div>
                        <span class="rsvp-status @StatusClass(sharedEvent.ResponseStatus)">@StatusLabel(sharedEvent.ResponseStatus)</span>
                    </div>
                    <label class="field">
                        <span>Add a comment <em>optional</em></span>
                        <textarea rows="2" maxlength="1000" placeholder="I'll join 10 minutes later." @bind="ResponseComment"></textarea>
                    </label>
                    @if (!string.IsNullOrWhiteSpace(ResponseFeedback))
                    {
                        <p class="rsvp-feedback @(ResponseFailed ? "error" : "success")" role="status">@ResponseFeedback</p>
                    }
                    <div class="rsvp-actions">
                        <button type="button" class="rsvp-decline @(sharedEvent.ResponseStatus == EventInvitationStatus.Declined ? "active" : "")"
                                disabled="@IsSubmitting" @onclick="() => Respond(EventInvitationStatus.Declined)">Decline</button>
                        <button type="button" class="rsvp-accept @(sharedEvent.ResponseStatus == EventInvitationStatus.Accepted ? "active" : "")"
                                disabled="@IsSubmitting" @onclick="() => Respond(EventInvitationStatus.Accepted)">Accept</button>
                    </div>
                </section>
            </div>
        }
        else
        {
            <div class="guest-event-error">
                <span class="eyebrow">INVITATION UNAVAILABLE</span>
                <h1>We can’t open this shared event.</h1>
                <p>@ErrorMessage</p>
                <a class="secondary-button" href="/login">Go to sign in</a>
            </div>
        }
    </section>
</main>

@code {
    [SupplyParameterFromQuery] public string? Token { get; set; }
    private GuestEventResult? Result;
    private string ResponseComment = string.Empty, ResponseFeedback = string.Empty;
    private bool ResponseFailed, IsSubmitting;
    private string ErrorMessage => Result?.Status == InvitationStatus.Expired
        ? "This invitation has expired. Ask the organizer to share the event again."
        : "This invitation is invalid or is no longer available.";

    protected override async Task OnParametersSetAsync()
    {
        Result = await InvitationService.GetGuestEventAsync(Token ?? string.Empty);
        ResponseComment = Result.Event?.ResponseComment ?? string.Empty;
    }

    private async Task Respond(EventInvitationStatus status)
    {
        IsSubmitting = true;
        ResponseFeedback = string.Empty;
        var response = await InvitationService.RespondAsGuestAsync(Token ?? string.Empty, status, ResponseComment);
        ResponseFailed = response.Status != InvitationResponseResultStatus.Success;
        if (!ResponseFailed)
        {
            Result = await InvitationService.GetGuestEventAsync(Token ?? string.Empty);
            ResponseComment = Result.Event?.ResponseComment ?? string.Empty;
            ResponseFeedback = status == EventInvitationStatus.Accepted
                ? "Your response is saved. We'll let the organizer know you're attending."
                : "Your response is saved. The organizer will see that you declined.";
        }
        else
        {
            ResponseFeedback = ResponseError(response.Status);
        }
        IsSubmitting = false;
    }

    private static string ResponseError(InvitationResponseResultStatus status) => status switch
    {
        InvitationResponseResultStatus.Expired => "This invitation has expired. Ask the organizer to share the event again.",
        InvitationResponseResultStatus.Conflict => "Your response changed in another session. Reload the invitation and try again.",
        InvitationResponseResultStatus.InvalidComment => "Comments cannot exceed 1,000 characters.",
        _ => "This invitation is no longer available."
    };

    private static string StatusClass(EventInvitationStatus status) => status.ToString().ToLowerInvariant();
    private static string StatusLabel(EventInvitationStatus status) => status switch
    {
        EventInvitationStatus.Accepted => "Accepted",
        EventInvitationStatus.Declined => "Declined",
        _ => "Pending"
    };

    private static string EventDate(GuestEventView item)
    {
        var finalDate = item.IsAllDay ? item.End.AddDays(-1) : item.End;
        return item.Start.Date == finalDate.Date
            ? item.Start.ToString("dddd, MMMM d, yyyy")
            : $"{item.Start:MMMM d, yyyy} – {finalDate:MMMM d, yyyy}";
    }

    private static string EventTime(GuestEventView item) => item.IsAllDay
        ? "All day"
        : $"{item.Start:h:mm tt} – {item.End:h:mm tt}";
}
