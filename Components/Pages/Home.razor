@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@using global::Calendar.Models
@using global::Calendar.Services
@inject CalendarStore Store
@inject IEventInvitationService InvitationService
@inject IJSRuntime JS

<PageTitle>Luma Calendar</PageTitle>

<div class="calendar-app">
    <aside class="sidebar-panel">
        <div class="brand"><span class="brand-mark">L</span><span>Luma</span></div>
        <LumaSectionNav />
        <button class="create-button" @onclick="CreateFromButton"><span>+</span> Create event</button>
        <section class="mini-calendar">
            <header><strong>@MiniDate.ToString("MMMM yyyy")</strong><div><button aria-label="Previous month" @onclick="() => MiniDate = MiniDate.AddMonths(-1)">‹</button><button aria-label="Next month" @onclick="() => MiniDate = MiniDate.AddMonths(1)">›</button></div></header>
            <div class="mini-weekdays">@foreach (var label in MiniWeekdays) { <span>@label</span> }</div>
            <div class="mini-grid">
                @foreach (var day in MiniDays)
                { <button class="@(day.Month != MiniDate.Month ? "muted" : "") @(day == DateTime.Today ? "today" : "") @(day == DisplayDate.Date ? "selected" : "")" @onclick="() => SelectMiniDay(day)">@day.Day</button> }
            </div>
        </section>
        <section class="calendar-list">
            <h3>Calendars</h3>
            <button class="@(Scope == "All" ? "active" : "")" @onclick='() => Scope = "All"'><i class="scope-icon all"></i> All events <span>@Store.Events.Count</span></button>
            <button class="@(Scope == "Mine" ? "active" : "")" @onclick='() => Scope = "Mine"'><i class="scope-icon mine"></i> Organized by me <span>@Store.Events.Count(e => e.OwnerId == Store.CurrentUserId)</span></button>
            <button class="@(Scope == "Shared" ? "active" : "")" @onclick='() => Scope = "Shared"'><i class="scope-icon shared"></i> Shared with me <span>@Store.Events.Count(e => e.IsCollaborator)</span></button>
            <button class="@(Scope == "Public" ? "active" : "")" @onclick='() => Scope = "Public"'><i class="scope-icon public"></i> Public events <span>@Store.Events.Count(e => e.IsPublic && e.OwnerId != Store.CurrentUserId)</span></button>
        </section>
        <div class="sidebar-footer"><span class="avatar">@Initials</span><div><strong>@Store.CurrentUserName</strong><small>Synced with MSSQL</small></div><form method="post" action="/account/logout"><AntiforgeryToken /><button title="Sign out" aria-label="Sign out">↗</button></form></div>
    </aside>

    <main class="calendar-main">
        <header class="main-header">
            <div class="mobile-section-navigation">
                <div class="mobile-brand"><span class="brand-mark">L</span><span>Luma</span></div>
                <LumaSectionNav />
            </div>
            <div class="header-primary">
                <button class="today-button" @onclick="GoToday">Today</button>
                <div class="nav-buttons"><button aria-label="Previous" @onclick="Previous">‹</button><button aria-label="Next" @onclick="Next">›</button></div>
                <h1>@PeriodLabel</h1>
            </div>
            <div class="header-actions">
                <div class="view-switcher" role="group" aria-label="Calendar view">
                    @foreach (var view in Views) { <button class="@(CurrentView == view ? "active" : "")" @onclick="() => SetView(view)">@view</button> }
                </div>
                <button class="mobile-create" aria-label="Create event" @onclick="CreateFromButton">+</button>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(Store.LastNotice))
        { <div class="store-notice">@Store.LastNotice</div> }
        @if (EditingEvent is null && !string.IsNullOrWhiteSpace(OperationError))
        { <div class="operation-error" role="alert">@OperationError</div> }

        <section class="calendar-surface" aria-live="polite">
            @if (!Store.IsReady)
            { <div class="loading-calendar"><div></div><div></div><div></div><div></div><span>Loading your calendar…</span></div> }
            else if (CurrentView == "Month")
            { <MonthView DisplayDate="DisplayDate" Events="VisibleEvents" CurrentMoment="CurrentMoment" EmptySelected="CreateEvent" DaySelected="OpenDay" EventSelected="OpenEvent" EventContextRequested="OpenContextMenu" /> }
            else
            { <TimeGridView Days="VisibleDays" Events="VisibleEvents" CurrentMoment="CurrentMoment" AutoScrollRequest="TimeGridScrollRequest" EmptySelected="CreateEvent" DaySelected="OpenDay" EventSelected="OpenEvent" EventContextRequested="OpenContextMenu" /> }
        </section>
    </main>
</div>

@if (ContextEvent is not null)
{
    <div class="event-context-layer" tabindex="-1" @ref="ContextMenuLayer"
         @onclick="CloseContextMenu" @onkeydown="HandleContextMenuKeyDown">
        <div class="event-context-menu @(ShowContextShare ? "event-context-share" : "")"
             role="@(ShowContextShare ? "dialog" : "menu")" aria-label="@(ShowContextShare ? "Share event" : "Event actions")"
             style="@ContextMenuStyle" @onclick:stopPropagation="true">
            @if (ShowContextShare)
            {
                <form @onsubmit="ShareFromContextMenu" @onsubmit:preventDefault="true">
                    <label for="context-share-email">Share <strong>@ContextEvent.Title</strong></label>
                    <input id="context-share-email" @ref="ContextShareInput" type="email" required
                           placeholder="collaborator@example.com" autocomplete="email"
                           @bind="ContextShareEmail" @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(ContextShareFeedback))
                    {
                        <p class="context-share-feedback @ContextShareFeedbackKind" role="status">@ContextShareFeedback</p>
                    }
                    <div class="event-context-confirm">
                        <button type="button" @onclick="CancelContextShare">@(ContextShareSucceeded ? "Close" : "Cancel")</button>
                        @if (!ContextShareSucceeded)
                        {
                            <button class="share" type="submit">Share</button>
                        }
                    </div>
                </form>
            }
            else if (ConfirmContextDelete)
            {
                <p>Delete <strong>@ContextEvent.Title</strong>?</p>
                <div class="event-context-confirm">
                    <button type="button" @onclick="CancelContextDeleteConfirmation">Cancel</button>
                    <button class="danger" type="button" @onclick="DeleteFromContextMenu">Delete</button>
                </div>
            }
            else
            {
                <button type="button" role="menuitem" @onclick="EditFromContextMenu">Edit</button>
                <button type="button" role="menuitem" @onclick="ShowContextShareForm">Share</button>
                <button class="danger" type="button" role="menuitem" @onclick="ShowContextDeleteConfirmation">Delete</button>
            }
        </div>
    </div>
}

@if (EditingEvent is not null)
{ <EventDialog @key="DialogKey" Event="EditingEvent" IsNew="IsCreating" ErrorMessage="@OperationError" CloseRequested="CloseDialog" SaveRequested="SaveEvent" DeleteRequested="DeleteEvent" RsvpRequested="RespondToInvitation" /> }

@code {
    private static readonly string[] Views = ["Month", "Week", "Day"];
    private static readonly string[] MiniWeekdays = ["M", "T", "W", "T", "F", "S", "S"];
    private DateTime DisplayDate = DateTime.Today;
    private DateTime MiniDate = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private string CurrentView = "Day";
    private string Scope = "All";
    private CalendarEvent? EditingEvent;
    private bool IsCreating;
    private int DialogKey;
    private string? OperationError;
    private DotNetObjectReference<Home>? DragDropReference;
    private System.Threading.Timer? ClockTimer;
    private DateTime CurrentMoment = DateTime.Now;
    private int TimeGridScrollRequest;
    private CalendarEvent? ContextEvent;
    private ElementReference ContextMenuLayer, ContextShareInput;
    private double ContextMenuX, ContextMenuY;
    private bool ConfirmContextDelete, ContextMenuNeedsFocus, ShowContextShare, ContextShareNeedsFocus, ContextShareSucceeded;
    private string ContextShareEmail = string.Empty, ContextShareFeedback = string.Empty, ContextShareFeedbackKind = string.Empty;
    [SupplyParameterFromQuery(Name = "event")] public Guid? RequestedEventId { get; set; }
    [SupplyParameterFromQuery(Name = "invitationError")] public string? InvitationError { get; set; }

    private IReadOnlyList<CalendarEvent> VisibleEvents => Scope switch
    {
        "Mine" => Store.Events.Where(item => item.OwnerId == Store.CurrentUserId).ToList(),
        "Shared" => Store.Events.Where(item => item.IsCollaborator).ToList(),
        "Public" => Store.Events.Where(item => item.OwnerId != Store.CurrentUserId && item.IsPublic).ToList(),
        _ => Store.Events
    };
    private string Initials => string.Concat(Store.CurrentUserName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));

    protected override void OnInitialized()
    {
        Store.Changed += OnStoreChanged;
        var now = DateTime.Now;
        CurrentMoment = now;
        var untilNextMinute = TimeSpan.FromMilliseconds(60_000 - now.Second * 1_000 - now.Millisecond);
        ClockTimer = new System.Threading.Timer(RefreshClock, null, untilNextMinute, TimeSpan.FromMinutes(1));
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Store.InitializeAsync();
            OperationError = InvitationError;
            if (RequestedEventId is { } eventId)
            {
                if (Store.Events.SingleOrDefault(item => item.Id == eventId) is { } requestedEvent)
                    OpenEvent(requestedEvent);
                else
                    OperationError = "That shared event is not available to this account.";
            }
            DragDropReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("lumaCalendarDrag.initialize", DragDropReference);
            StateHasChanged();
        }
        if (ContextShareNeedsFocus)
        {
            ContextShareNeedsFocus = false;
            await ContextShareInput.FocusAsync(preventScroll: true);
        }
        else if (ContextMenuNeedsFocus)
        {
            ContextMenuNeedsFocus = false;
            await ContextMenuLayer.FocusAsync(preventScroll: true);
        }
    }

    private IReadOnlyList<DateTime> VisibleDays
    {
        get
        {
            if (CurrentView == "Day") return [DisplayDate.Date];
            var start = DisplayDate.Date.AddDays(-(((int)DisplayDate.DayOfWeek + 6) % 7));
            return Enumerable.Range(0, 7).Select(day => start.AddDays(day)).ToList();
        }
    }
    private string PeriodLabel => CurrentView switch { "Day" => DisplayDate.ToString("dddd, MMMM d"), "Week" => WeekLabel(), _ => DisplayDate.ToString("MMMM yyyy") };
    private IEnumerable<DateTime> MiniDays
    {
        get
        {
            var start = MiniDate.AddDays(-(((int)MiniDate.DayOfWeek + 6) % 7));
            return Enumerable.Range(0, 42).Select(day => start.AddDays(day));
        }
    }
    private string WeekLabel()
    {
        var days = VisibleDays;
        return days[0].Month == days[^1].Month ? $"{days[0]:MMMM d}–{days[^1]:d, yyyy}" : $"{days[0]:MMM d} – {days[^1]:MMM d, yyyy}";
    }
    private void Previous()
    {
        DisplayDate = CurrentView switch { "Month" => DisplayDate.AddMonths(-1), "Week" => DisplayDate.AddDays(-7), _ => DisplayDate.AddDays(-1) };
        RequestTodayScrollIfVisible();
    }
    private void Next()
    {
        DisplayDate = CurrentView switch { "Month" => DisplayDate.AddMonths(1), "Week" => DisplayDate.AddDays(7), _ => DisplayDate.AddDays(1) };
        RequestTodayScrollIfVisible();
    }
    private void GoToday()
    {
        DisplayDate = CurrentMoment.Date;
        MiniDate = new(CurrentMoment.Year, CurrentMoment.Month, 1);
        RequestTodayScrollIfVisible();
    }
    private void SetView(string view)
    {
        CurrentView = view;
        RequestTodayScrollIfVisible();
    }
    private void SelectMiniDay(DateTime day)
    {
        DisplayDate = day;
        MiniDate = new(day.Year, day.Month, 1);
        RequestTodayScrollIfVisible();
    }
    private void OpenDay(DateTime day)
    {
        DisplayDate = day;
        CurrentView = "Day";
        RequestTodayScrollIfVisible();
    }
    private void CreateFromButton() => CreateEvent(DisplayDate.Date.AddHours(9));
    private void CreateEvent(DateTime start) => CreateEvent(start, start.AddHours(1));
    private void CreateEvent(DateTime start, DateTime end)
    {
        if (CalendarTimeRules.IsPastDate(start, CurrentMoment.Date))
        {
            EditingEvent = null;
            OperationError = CalendarTimeRules.PastDateMessage;
            return;
        }

        OperationError = null;
        EditingEvent = new CalendarEvent { Start = start, End = end, Color = "violet", CanEdit = true, OwnerId = Store.CurrentUserId, OwnerName = Store.CurrentUserName };
        IsCreating = true;
        DialogKey++;
    }
    private void OpenEvent(CalendarEvent item) { OperationError = null; EditingEvent = item.Copy(); IsCreating = false; DialogKey++; }
    private async Task RespondToInvitation(InvitationResponseRequest request)
    {
        if (EditingEvent is not { } item) return;
        var result = await InvitationService.RespondAsUserAsync(
            item.Id, Store.CurrentUserId, request.Status, request.Comment);
        if (result.Status == InvitationResponseResultStatus.Success)
        {
            OperationError = null;
            await Store.ReloadAsync();
            EditingEvent = Store.Events.SingleOrDefault(calendarEvent => calendarEvent.Id == item.Id)?.Copy();
            DialogKey++;
            return;
        }

        OperationError = result.Status switch
        {
            InvitationResponseResultStatus.Conflict => "Your response changed in another session. The latest response has been loaded; please try again.",
            InvitationResponseResultStatus.InvalidComment => "Comments cannot exceed 1,000 characters.",
            InvitationResponseResultStatus.Expired => "This invitation has expired.",
            _ => "You are not authorized to respond to this invitation."
        };
        await Store.ReloadAsync();
        EditingEvent = Store.Events.SingleOrDefault(calendarEvent => calendarEvent.Id == item.Id)?.Copy();
        DialogKey++;
    }
    private void CloseDialog() { OperationError = null; EditingEvent = null; }
    private async Task SaveEvent(CalendarEvent item)
    {
        try
        {
            if (IsCreating) await Store.CreateAsync(item);
            else await Store.UpdateAsync(item);
            EditingEvent = null;
            DisplayDate = item.Start.Date;
        }
        catch (Exception exception) when (exception is System.ComponentModel.DataAnnotations.ValidationException or EventConcurrencyException or UnauthorizedAccessException)
        {
            OperationError = exception.Message;
            if (exception is EventConcurrencyException) await Store.ReloadAsync();
        }
    }
    private async Task DeleteEvent(CalendarEvent item)
    {
        try
        {
            await Store.DeleteAsync(item.Id, item.Version);
            EditingEvent = null;
        }
        catch (Exception exception) when (exception is EventConcurrencyException or UnauthorizedAccessException)
        {
            OperationError = exception.Message;
            if (exception is EventConcurrencyException) await Store.ReloadAsync();
        }
    }
    private void OpenContextMenu(EventContextRequest request)
    {
        if (!request.Event.CanEdit) return;
        OperationError = null;
        ContextEvent = request.Event.Copy();
        ContextMenuX = request.ClientX;
        ContextMenuY = request.ClientY;
        ConfirmContextDelete = false;
        ShowContextShare = false;
        ResetContextShare();
        ContextMenuNeedsFocus = true;
    }
    private void CloseContextMenu()
    {
        ContextEvent = null;
        ConfirmContextDelete = false;
        ShowContextShare = false;
        ResetContextShare();
        ContextMenuNeedsFocus = false;
    }
    private void HandleContextMenuKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseContextMenu();
    }
    private void ShowContextDeleteConfirmation()
    {
        ShowContextShare = false;
        ConfirmContextDelete = true;
        ContextMenuNeedsFocus = true;
    }
    private void CancelContextDeleteConfirmation()
    {
        ConfirmContextDelete = false;
        ContextMenuNeedsFocus = true;
    }
    private void ShowContextShareForm()
    {
        ConfirmContextDelete = false;
        ShowContextShare = true;
        ResetContextShare();
        ContextShareNeedsFocus = true;
    }
    private void CancelContextShare()
    {
        ShowContextShare = false;
        ResetContextShare();
        ContextMenuNeedsFocus = true;
    }
    private async Task ShareFromContextMenu()
    {
        if (ContextEvent is not { } item) return;
        var email = ContextShareEmail.Trim();
        if (!new System.ComponentModel.DataAnnotations.EmailAddressAttribute().IsValid(email))
        {
            SetContextShareFeedback("Enter a valid email address.", "error");
            return;
        }
        if (item.CollaboratorEmails.Contains(email, StringComparer.OrdinalIgnoreCase))
        {
            ContextShareSucceeded = true;
            SetContextShareFeedback("This user is already a collaborator.", "success");
            return;
        }

        try
        {
            var updated = item.Copy();
            updated.CollaboratorEmails.Add(email);
            await Store.UpdateAsync(updated);
            ContextEvent = Store.Events.SingleOrDefault(calendarEvent => calendarEvent.Id == item.Id)?.Copy() ?? updated;
            var wasShared = ContextEvent.CollaboratorEmails.Contains(email, StringComparer.OrdinalIgnoreCase);
            ContextShareSucceeded = wasShared;
            if (wasShared && string.IsNullOrWhiteSpace(Store.LastNotice))
                SetContextShareFeedback($"Event shared with {email}.", "success");
            else if (wasShared)
                SetContextShareFeedback(Store.LastNotice!, "warning");
            else
                SetContextShareFeedback(Store.LastNotice ?? "No registered LUMA user was found for that email.", "error");
        }
        catch (Exception exception) when (exception is System.ComponentModel.DataAnnotations.ValidationException or EventConcurrencyException or UnauthorizedAccessException)
        {
            SetContextShareFeedback(exception.Message, "error");
            if (exception is EventConcurrencyException)
            {
                await Store.ReloadAsync();
                ContextEvent = Store.Events.SingleOrDefault(calendarEvent => calendarEvent.Id == item.Id)?.Copy();
            }
        }
        catch
        {
            SetContextShareFeedback("The event could not be shared. Please try again.", "error");
        }
    }
    private void SetContextShareFeedback(string message, string kind)
    {
        ContextShareFeedback = message;
        ContextShareFeedbackKind = kind;
    }
    private void ResetContextShare()
    {
        ContextShareEmail = string.Empty;
        ContextShareFeedback = string.Empty;
        ContextShareFeedbackKind = string.Empty;
        ContextShareSucceeded = false;
        ContextShareNeedsFocus = false;
    }
    private void EditFromContextMenu()
    {
        if (ContextEvent is not { } item) return;
        CloseContextMenu();
        OpenEvent(item);
    }
    private async Task DeleteFromContextMenu()
    {
        if (ContextEvent is not { } item) return;
        CloseContextMenu();
        await DeleteEvent(item);
    }
    private string ContextMenuStyle
    {
        get
        {
            var width = ShowContextShare ? 292 : 180;
            var height = ShowContextShare ? 220 : 126;
            return FormattableString.Invariant(
                $"left:min(calc(100vw - {width}px), {Math.Max(8, ContextMenuX):0.##}px);top:min(calc(100vh - {height}px), {Math.Max(8, ContextMenuY):0.##}px)");
        }
    }
    [JSInvokable]
    public async Task HandleCalendarTimeSelection(string startValue, string endValue)
    {
        const string format = "yyyy-MM-ddTHH:mm:ss";
        if (!DateTime.TryParseExact(startValue, format, System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var start) ||
            !DateTime.TryParseExact(endValue, format, System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var end) ||
            !VisibleDays.Contains(start.Date) || end <= start || end - start > TimeSpan.FromDays(1) ||
            start.Minute % 30 != 0 || end.Minute % 30 != 0 ||
            start.Ticks % TimeSpan.TicksPerMinute != 0 || end.Ticks % TimeSpan.TicksPerMinute != 0)
        {
            OperationError = "That time selection is no longer valid. Please choose a time from the calendar again.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (CalendarTimeRules.IsPastDate(start, CurrentMoment.Date))
        {
            OperationError = CalendarTimeRules.PastDateMessage;
            await InvokeAsync(StateHasChanged);
            return;
        }

        CreateEvent(start, end);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task HandleCalendarDrop(string eventId, string targetValue, string targetKind, bool copy)
    {
        OperationError = null;
        if (!Guid.TryParse(eventId, out var id) ||
            !DateTime.TryParseExact(targetValue, targetKind == "day" ? "yyyy-MM-dd" : "yyyy-MM-ddTHH:mm:ss",
                System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var target) ||
            Store.Events.SingleOrDefault(item => item.Id == id) is not { } source)
        {
            OperationError = "The dragged event or destination is no longer available. Your calendar has been refreshed.";
            await Store.ReloadAsync();
            return;
        }

        var targetStart = targetKind switch
        {
            "day" when source.IsAllDay => target.Date,
            "day" => target.Date.Add(source.Start.TimeOfDay),
            "time" when source.IsAllDay => target.Date,
            "time" => target,
            _ => default
        };
        if (targetStart == default)
        {
            OperationError = "That calendar destination is not valid.";
            await InvokeAsync(StateHasChanged);
            return;
        }
        if (CalendarTimeRules.IsPastDate(targetStart, CurrentMoment.Date))
        {
            OperationError = CalendarTimeRules.PastDateMessage;
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            if (copy)
                await Store.CopyAsync(source.Id, source.Version, targetStart);
            else
                await Store.MoveAsync(source.Id, source.Version, targetStart);
            DisplayDate = targetStart.Date;
        }
        catch (Exception exception) when (exception is System.ComponentModel.DataAnnotations.ValidationException or EventConcurrencyException or UnauthorizedAccessException)
        {
            OperationError = exception.Message;
            await Store.ReloadAsync();
        }
        catch
        {
            OperationError = copy
                ? "The event could not be copied. No calendar changes were made; please try again."
                : "The event could not be moved. Your calendar has been refreshed; please try again.";
            try { await Store.ReloadAsync(); } catch { }
        }
    }
    private void RequestTodayScrollIfVisible()
    {
        if (CurrentView != "Month" && VisibleDays.Contains(CurrentMoment.Date)) TimeGridScrollRequest++;
    }
    private void RefreshClock(object? state)
    {
        _ = InvokeAsync(() =>
        {
            CurrentMoment = DateTime.Now;
            StateHasChanged();
        });
    }
    private void OnStoreChanged() => InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        Store.Changed -= OnStoreChanged;
        ClockTimer?.Dispose();
        DragDropReference?.Dispose();
    }
}
