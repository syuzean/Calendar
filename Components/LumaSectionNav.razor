@rendermode InteractiveServer
@inject InboxStore InboxStore
@inject NavigationManager Navigation
@using global::Calendar.Services
@implements IDisposable

<nav class="luma-section-nav" aria-label="Luma sections">
    <NavLink href="/" Match="NavLinkMatch.All">
        <span class="luma-nav-icon" aria-hidden="true">▦</span><span>Calendar</span>
    </NavLink>
    <NavLink href="/tasks">
        <span class="luma-nav-icon" aria-hidden="true">✓</span><span>Tasks</span>
    </NavLink>
    <NavLink href="/inbox" class="luma-inbox-link">
        <span class="luma-nav-icon" aria-hidden="true">◇</span><span>Inbox</span>
        @if (UnreadCount > 0)
        {
            <span class="luma-inbox-badge">@(UnreadCount > 99 ? "99+" : UnreadCount)</span>
        }
    </NavLink>
</nav>

@code {
    [Parameter] public long RefreshKey { get; set; }
    private int UnreadCount;
    private long? LoadedRefreshKey;

    protected override void OnInitialized()
    {
        InboxStore.Changed += HandleInboxChanged;
        Navigation.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (LoadedRefreshKey == RefreshKey) return;
        LoadedRefreshKey = RefreshKey;
        await LoadUnreadCountAsync();
    }

    private async Task LoadUnreadCountAsync()
    {
        try { UnreadCount = await InboxStore.GetUnreadCountAsync(); }
        catch (UnauthorizedAccessException) { UnreadCount = 0; }
    }

    private void HandleInboxChanged() => _ = InvokeAsync(async () =>
    {
        await LoadUnreadCountAsync();
        StateHasChanged();
    });

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args) => HandleInboxChanged();

    public void Dispose()
    {
        InboxStore.Changed -= HandleInboxChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
